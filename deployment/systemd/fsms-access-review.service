# 临时权限授予的定期复核与到期收敛（systemd oneshot service）
#
# 由 fsms-access-review.timer 每小时拉起一次，做两件事：
#   1) --expire：把 {status:'active', expiresAt <= now} 的授予置为 expired（记录保留，不删）；
#   2) 打印 reviewSummary / 超期未复核清单，落到 journal 供测评取证。
#
# 为什么要有这个服务：权限是否生效由**读取路径**判定（见 ADR-012），
# 所以本服务停摆不会让过期权限复活；它的失效形态只是「状态与清单不刷新」。
# 这一条必须写清楚，否则运维会误以为本服务是控制措施本身。
#
# 安装：
#   # 专用低权账号（本服务运行身份；不要复用 root 或部署用户）：
#   sudo groupadd --system fsms-review
#   sudo useradd  --system --gid fsms-review --home-dir /var/lib/fsms-review \
#                 --shell /usr/sbin/nologin fsms-review
#   # 本服务生产上只消费 ./secrets/mongodb_uri（.env 里只配 MONGODB_URI_FILE，
#   # 见 secret-rotation.md 的生产口径 b）。该文件默认 0600、属主是执行部署的用户，
#   # 专用账号读不到 ⇒ 每轮 EACCES。按 secret-rotation.md 的属组化口径把它
#   # 收进服务组（仅放开本服务需要的那一份，不要整目录放宽）：
#   sudo chgrp fsms-review /opt/fsms/secrets/mongodb_uri
#   sudo chmod 0640        /opt/fsms/secrets/mongodb_uri
#   sudo install -m 0644 fsms-access-review.service /etc/systemd/system/
#   sudo install -m 0644 fsms-access-review.timer   /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now fsms-access-review.timer
#   journalctl -u fsms-access-review -n 50

[Unit]
Description=FSMS privilege grant review and expiry sweep
Documentation=file:/opt/fsms/docs/adr/ADR-012-临时权限授予与定期复核.md
After=network-online.target mongod.service
Wants=network-online.target

[Service]
Type=oneshot
# 复用应用自身的 .env（生产口径只含 *_FILE 指针等非明文项）；缺文件时本服务起不来是期望行为
WorkingDirectory=/opt/fsms
EnvironmentFile=/opt/fsms/.env
ExecStart=/usr/bin/node /opt/fsms/scripts/access-review.js --expire
# 读全表扫超期，分钟级足够；给 10 分钟上限让「卡住」变成可解释状态
TimeoutStartSec=10min
# 只读业务库的授权集合，不需要任何特权
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes

# ===== 最小权限（2026-11-14 审计收口：不得以 root 跑无特权脚本）=====
# 本脚本只读 .env 注入的连接串、写业务库的授权集合、打印到 journal——没有任何
# 特权需求，但本文件原先没有 User=，systemd 默认以 root 运行整段 oneshot。
#
# 运行身份（2026-11-15 审计 P2-31 修正）：改用**预建专用账号** fsms-review。
# 此前的 DynamicUser 即弃 UID 读不到属主为部署用户、权限 0600 的
# ./secrets/mongodb_uri（.env 按 secret-rotation.md 生产口径只配
# MONGODB_URI_FILE 指针），每轮在 hydrate 阶段 EACCES 失败，逼运维把明文
# URI 写回 .env——正好违反仓库自己的密钥载体纪律。专用账号 + 把该 secret
# 属组化（见文件头安装步骤）让「.env 不落明文」与「服务读得到」同时成立；
# systemd 以 root 读取 EnvironmentFile 后注入进程，.env 本身无需放权。
# 不要把 ./secrets/ 整目录改成组可读：需要放行的只有本服务点名要用的那一份。
User=fsms-review
Group=fsms-review
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
# 全盘只读（比 full 更严：/usr、/etc、/opt 全部不可写，仓库自然只读）。
# 可写面收敛到 StateDirectory（systemd 预建、属主即 fsms-review，经隐式
# ReadWritePaths 放行）：winston 的文件日志改落到这里，经 LOG_DIR 注入
# （src/utils/logPaths.js 的单一声明），不与仓库内 logs/ 混写。
ProtectSystem=strict
StateDirectory=fsms-review
Environment=LOG_DIR=/var/lib/fsms-review/logs
# 不重启：下一轮 timer 自然重试，重启风暴只会刷屏 journal
Restart=no

[Install]
WantedBy=multi-user.target
