# /etc/fsms/hot-upgrade.env —— 热升级宿主代理的环境（0640 root:root）
#
# 与应用容器的配置**必须对齐**的三项：
#   · UPGRADE_QUEUE_DIR  —— 与 compose 的 UPGRADE_QUEUE_HOST_DIR 相同
#   · HOT_UPGRADE_REGISTRY_ALLOWLIST —— 与应用容器内同名变量相同
#   · HMAC 密钥 —— 与应用容器的 /run/secrets/hmac_secret 是同一份
#
# 不等价时不会「两边各自工作」，而是每一次请求都验签失败或白名单拒绝；
# 应用侧会显示「升级代理未就绪」或任务被拒绝，不会静默执行。

# 队列目录（宿主路径）
UPGRADE_QUEUE_DIR=/var/lib/fsms/upgrade

# 离线包目录（宿主路径；scripts/importOfflineBundle.js 从这里读包）。
# 断网/内网机器无法从 registry 拉取目标 digest，镜像改由离线包导入后再走同一套蓝绿七步。
# 默认放在 UPGRADE_QUEUE_DIR 之内：单元的 ReadWritePaths 已经放开 /var/lib/fsms/upgrade，
# 放在别处（尤其是 /root、/home）会被 ProtectHome=yes / ProtectSystem=full 挡住，
# 而报错会表现成「读包失败」，看起来像包坏了。
# 属主必须只有 root（0700）：能把包放进这个目录的账号 = 能决定线上跑什么代码。
# 代理每轮扫描该目录（只读 manifest + 白名单，不算 payload 哈希），可用包摘要经
# heartbeat.json 的 bundles 字段公布给应用——应用内「一键离线升级」的下拉候选来自这里。
OFFLINE_BUNDLE_DIR=/var/lib/fsms/upgrade/bundles

# 落位收件目录：运维把构建产出的 `fsms-offline-<版本>.tar.gz` 与它的 `.sig` 传到这里
# （scp 直传即可，不必先写 .part），代理每轮最多落位**一个**包到上面的 bundles 目录。
#   落位判据：静默期（OFFLINE_BUNDLE_SETTLE_SECONDS）内不再写入 + 两次读数尺寸一致
#             —— 正在传的包不会被当成完整的；未就绪的包进心跳 intake.pending
#   （应用侧「关于」页的升级弹窗会显示「已传完、等待落位」与失败原因）。
# 与 OFFLINE_BUNDLE_DIR 同纪律：属主必须只有 root（0700）——能写这个目录的账号
# = 能决定线上跑什么代码。默认落在 UPGRADE_QUEUE_DIR 之内，已被单元的 ReadWritePaths 覆盖。
OFFLINE_BUNDLE_INBOX=/var/lib/fsms/upgrade/inbox

# 传输静默期（秒）：归档 mtime 距今不足该秒数即视为「可能还在写」。默认 60。
# 调小的代价是「大文件传到一半就被解包」（会以解包错误收场，而不是「还没传完」）；
# 内网万兆环境可调到 30，跨公网慢链路建议 120。
# OFFLINE_BUNDLE_SETTLE_SECONDS=60

# 归档外层验签公钥：与 OFFLINE_BUNDLE_VERIFY_PUBKEY 是**同一把**（下面那条）。
# 落位（offlineBundleIntake）与导入（importOfflineBundle）都读它——两把钥匙会让
# 「外层验过、内层验不过」在现场难以解释。未配置 = 两层都跳过验签并留痕明示。

# 离线包验签公钥（Ed25519 PEM；构建机用 build-offline-bundle.sh --sign-key 签名）。
# 配置后 = fail-closed：未签名或验签失败的包一律拒绝导入（应用内一键与 CLI 导入同口径）；
# 不配置 = 不验签，留痕里会明示 signature=unchecked。公钥不是机密，但建议与其它密钥同放：
#   install -m 0600 -o root -g root offline_bundle.pub /etc/fsms/secrets/offline_bundle.pub
# 构建侧密钥生成（只在联机构建机执行，私钥永不出机）：
#   openssl genpkey -algorithm ed25519 -out offline_bundle_sign.pem
#   openssl pkey -in offline_bundle_sign.pem -pubout -out offline_bundle.pub
# OFFLINE_BUNDLE_VERIFY_PUBKEY=/etc/fsms/secrets/offline_bundle.pub

# 镜像白名单（逗号分隔前缀）。空白名单 = 全拒。
HOT_UPGRADE_REGISTRY_ALLOWLIST=ghcr.io/qmzzzzz/

# 含 upstream fsms_app 的 nginx 主配置
HOT_UPGRADE_NGINX_CONF=/etc/nginx/nginx.conf

# 与应用同一份 HMAC 密钥（scripts/generate-secrets.js 产出的 hmac_secret）
HMAC_SECRET_FILE=/etc/fsms/secrets/hmac_secret

# 与应用相同的请求 TTL / 概览历史条数
UPGRADE_REQUEST_TTL_SECONDS=1800
UPGRADE_HISTORY_LIMIT=50

# 若部署目录不是 /opt/fsms，改 service 的 WorkingDirectory，并在这里显式指定：
# HOT_UPGRADE_COMPOSE_FILE=/opt/fsms/docker-compose.yml

# 自编译/容器化 nginx 的二进制路径不同时覆盖（默认 PATH 里的 nginx）
# HOT_UPGRADE_NGINX_BIN=/usr/sbin/nginx

# ── 备份步骤（代理执行 scripts/hotUpgrade.js 时会先跑 scripts/backup-mongo.sh）──
# 这三个变量缺任一，第一个升级请求都会停在 backup 步并以非零退出——而本服务
# 的环境**只来自本文件**（不是 compose 的 .env），所以不能指望那边配过就自动生效。
# 生产用 MONGODB_URI_FILE 指针：连接串含凭据，走 environment 会出现在 /proc/<pid>/environ。
MONGODB_URI_FILE=/etc/fsms/secrets/mongodb_uri
# gpg（默认）| plaintext-acknowledged（明文需显式承认风险）
BACKUP_ENCRYPTION=gpg
# gpg 模式的收件人；未配置时 backup-mongo.sh 会在采集前就失败（不会先花几分钟导出）。
# 密钥环固定在 /var/lib/fsms/gnupg（单元里设了 GNUPGHOME：ProtectHome=yes 会藏掉 /root）：
#   sudo -u root gpg --homedir /var/lib/fsms/gnupg --import ops-pubkey.asc
# 私有镜像仓库同理：docker login --config /var/lib/fsms/docker <registry>
# BACKUP_GPG_RECIPIENT=ops@example.com
