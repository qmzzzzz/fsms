# /etc/fsms/hot-upgrade.env —— 热升级宿主代理的环境（0640 root:root）
#
# 与应用容器的配置**必须对齐**的三项：
#   · UPGRADE_QUEUE_DIR  —— 与 compose 的 UPGRADE_QUEUE_HOST_DIR 相同
#   · HOT_UPGRADE_REGISTRY_ALLOWLIST —— 与应用容器内同名变量相同
#   · HMAC 密钥 —— 与应用容器的 /run/secrets/hmac_secret 是同一份
#
# 不等价时不会「两边各自工作」，而是每一次请求都验签失败或白名单拒绝；
# 应用侧会显示「升级代理未就绪」或任务被拒绝，不会静默执行。

# 队列目录（宿主路径）
UPGRADE_QUEUE_DIR=/var/lib/fsms/upgrade

# 镜像白名单（逗号分隔前缀）。空白名单 = 全拒。
HOT_UPGRADE_REGISTRY_ALLOWLIST=ghcr.io/qmzzzzz/

# 含 upstream fsms_app 的 nginx 主配置
HOT_UPGRADE_NGINX_CONF=/etc/nginx/nginx.conf

# 与应用同一份 HMAC 密钥（scripts/generate-secrets.js 产出的 hmac_secret）
HMAC_SECRET_FILE=/etc/fsms/secrets/hmac_secret

# 与应用相同的请求 TTL / 概览历史条数
UPGRADE_REQUEST_TTL_SECONDS=1800
UPGRADE_HISTORY_LIMIT=50

# 若部署目录不是 /opt/fsms，改 service 的 WorkingDirectory，并在这里显式指定：
# HOT_UPGRADE_COMPOSE_FILE=/opt/fsms/docker-compose.yml

# 自编译/容器化 nginx 的二进制路径不同时覆盖（默认 PATH 里的 nginx）
# HOT_UPGRADE_NGINX_BIN=/usr/sbin/nginx

# ── 备份步骤（代理执行 scripts/hotUpgrade.js 时会先跑 scripts/backup-mongo.sh）──
# 这三个变量缺任一，第一个升级请求都会停在 backup 步并以非零退出——而本服务
# 的环境**只来自本文件**（不是 compose 的 .env），所以不能指望那边配过就自动生效。
# 生产用 MONGODB_URI_FILE 指针：连接串含凭据，走 environment 会出现在 /proc/<pid>/environ。
MONGODB_URI_FILE=/etc/fsms/secrets/mongodb_uri
# gpg（默认）| plaintext-acknowledged（明文需显式承认风险）
BACKUP_ENCRYPTION=gpg
# gpg 模式的收件人；未配置时 backup-mongo.sh 会在采集前就失败（不会先花几分钟导出）。
# 密钥环固定在 /var/lib/fsms/gnupg（单元里设了 GNUPGHOME：ProtectHome=yes 会藏掉 /root）：
#   sudo -u root gpg --homedir /var/lib/fsms/gnupg --import ops-pubkey.asc
# 私有镜像仓库同理：docker login --config /var/lib/fsms/docker <registry>
# BACKUP_GPG_RECIPIENT=ops@example.com
