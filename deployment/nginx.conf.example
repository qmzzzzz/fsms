# 生产部署参考：Nginx TLS 终结 + 安全头
#
# 【M-2 为什么生产必须 TLS 终结】
#   应用层的登录口令 ECDH 加密**不是 TLS 的替代品**：它只在「被动窃听」场景下
#   增加一层纵深。纯 HTTP 部署时，主动 MITM 攻击者可以篡改页面下发的服务端公钥
#   （首次公钥经明文 HTTP 送达，无指纹预置/固定），把客户端引到自己的密钥上，
#   口令密文对他完全透明——ECDH 形同虚设。因此：
#   - 生产一律由本层（或等价网关）做 TLS 终结，后端仅在内网走明文；
#   - ECDH 的定位是纵深防御（例如 TLS 配置失误、内网嗅探时的额外一层），
#     不得作为「可以不上 HTTPS」的理由。
#
# 审计整改说明（2026-08-20）：
#   - 扫描器报告的"未使用HTTPS协议 / 未配置HSTS"属于传输层问题，应用代码无法在
#     明文 HTTP 上安全地满足（浏览器按 RFC 6797 仅采纳经 HTTPS 送达的 HSTS）。
#   - 正确做法是在反向代理层做 TLS 终结并下发 HSTS 与全套安全头，本文件即参考实现。
#   - 后端已内置 Strict-Transport-Security 兜底下发（src/middleware/security.js ensureHsts），
#     前端 dev/preview 已在 vite.config.js 下发安全头；此配置用于生产域名的最终落地。
#
# 使用：替换 your-domain.example、证书路径后启用，并将 80 端口重定向到 443。
#
# 审计整改说明（2026-10-01）：
#   - finding #6「前端文档零 CSP」：静态直出路径（location / 与 /assets/）补 nginx 侧
#     静态 CSP——此前 SPA 由 try_files 直出、完全不经过后端 nonce CSP（src/middleware/
#     security.js 只覆盖反代路径），前端面等于无 CSP 裸奔。反代路径维持后端下发、
#     nginx 不叠加（交集问题只发生在同一响应携带两个 CSP，按路径分工即可化解）。
#   - finding #10「nginx 缺边缘资源闸与兜底块」：补 limit_req（/api 两条入口）、
#     超时族（client_header/body_timeout、send/keepalive_timeout + 反代块
#     proxy_connect/send_timeout 显式钉值）、client_max_body_size 1m（与后端
#     body parser 显式对齐）与 443 default_server 兜底块
#     （ssl_reject_handshake + return 444）。契约由
#     src/tests/deploy/nginxProxyContract.test.js 把守。
#
# 审计整改说明（2026-10-31）：
#   - 取证加固（取证任务书 §1.6）：http 级限速拆为 login/strict/general 三档（当前只把
#     general 挂在 /api 两条入口，login/strict 给出启用模板与前置条件）；全部 7 个反代块
#     补两条 TLS 取证头（X-Tls-Protocol/X-Tls-Cipher）；新增取证日志格式 fsms_forensic
#     （默认不挂线，见「访问日志」段的启用说明）；补 XFF 信任边界口径（与应用层
#     utils/ipUtils.clientIpForSecurityDecision 对齐）。
#   - 边缘/应用分工、DDoS 时应用日志降级机理、按 IP 统计速查见 deployment/edge-protection.md；
#     应用侧两级捕获管道（常态头级 / 触发式全量）由 P2 交付；P1 已落地的标记表见
#     src/services/forensicTrigger.js（「要不要升级为全量捕获」的唯一事实来源）。
#   - 以上指令的契约仍由 src/tests/deploy/nginxProxyContract.test.js 与
#     deployment/config-drift-baseline.json 把守。

# ===== 边缘资源闸（finding #10；本文件按 conf.d include 进 http{}，此处为 http 级指令）=====
# 慢速攻击（slowloris / slow-read / slow-post）防线：威胁模型把这类防线显式交给
# nginx 超时（后端 body parser 不做请求级超时，Node 默认 timeout 也不以「踢掉慢连接」
# 为语义）。取值原则：比最慢的合法客户端更宽，比攻击者挂连接的成本更窄。
client_header_timeout 10s;   # 请求头整体送达期限；合法客户端一个 RTT 内发完，10s 已覆盖极慢移动网络
client_body_timeout 30s;     # body 相邻两次读之间的上限（非总时长）；1MB 上限下足够宽松
send_timeout 60s;            # 向客户端写响应的相邻写间隔上限；显式钉住默认值，防上游 nginx.conf 静默变更
keepalive_timeout 30s;       # 默认 75s 偏长：缩短半开连接占用窗口，SPA 短请求场景无感

# 请求体上限与后端 body parser **显式对齐**（src/app.js: express.json / express.urlencoded
# limit '1mb' = 1048576B，nginx 1m 同值）：超限请求 nginx 直接回 413，根本不进 Node 的
# JSON.parse。这是显式声明而非巧合一致——任一侧调整必须同步另一侧。
# WebSocket 升级请求没有请求体、socket.io 轮询 POST 是小帧，均不受影响；
# 全仓无文件上传路由（无 multer/multipart），不存在被误伤的合法大请求体。
client_max_body_size 1m;

# ── 边缘限速三档（login / strict / general，2026-10-31 取证加固）──────────────────
# 全部按 $binary_remote_addr（裸 IP）分桶，令牌桶状态在 10m 共享内存里。默认值刻意
# 保守：一律比应用侧同端点配额宽 1~2 个数量级（倍数按默认配置算），只截扫描器/
# 爆破量级的洪峰——应用限流带白名单/探针豁免、审计与 JSON 429 语义，必须让它当
# 主闸；边缘闸只是在 Node 事件循环与 JSON.parse 之前丢洪峰的那道。三档如下：
#   - login（登录/认证端点，暴力破解主战场）：rate=2r/s ≈ 应用侧 loginLimiter（10 次/
#     15 分钟/IP ≈ 0.011 r/s，仅按 IP、成功不计）的 180 倍；burst=5。单账号高频撞库
#     归应用侧账号维度限流，本档只按 IP 兜底洪峰，两者独立计数、互不顶替。
#   - strict（写类/敏感端点：批量写入、导出、权限变更等）：rate=5r/s ≈ 应用侧
#     strictLimiter（30 次/15 分钟/IP ≈ 0.033 r/s）的 150 倍；burst=10。
#   - general（/api 常规流量）：rate=10r/s ≈ 应用侧 generalLimiter（300 次/15 分钟/IP
#     ≈ 0.33 r/s，src/config/index.js rateLimit 默认 + src/middleware/rateLimit.js）的
#     30 倍；burst=20 nodelay。nodelay 立即放行突发额度而非延迟整形——给交互式 API
#     加延迟没有安全收益，只有体验损失。本档是当前**唯一激活**的档，挂 /api 两条入口。
# 内存账：三档各 10m（≈16 万个 IPv4 客户端状态/档，每状态约 64B）；按最坏 30MB
# 预算，用不到的档整行删除即可。调参指引：改 rate 前先算「应用侧同端点持续配额 ×
# 1~2 位余量」；改**落点**前先读 src/tests/deploy/nginxProxyContract.test.js 的
# 「limit_req 只落在 /api 两条入口」断言——限速落点是需评审的变更，新增落点须
# 同步该测试的期望表（模板与注意事项见下）。
limit_req_zone $binary_remote_addr zone=login:10m rate=2r/s;
limit_req_zone $binary_remote_addr zone=strict:10m rate=5r/s;
limit_req_zone $binary_remote_addr zone=general:10m rate=10r/s;

# 启用模板（默认注释；把哪条指令挂到哪个 location 是部署决策，本文件只给保守形态）：
#   - 登录端点（示例路径，以实际路由为准）：在比 /api/ 更精确的 location 里单挂
#       limit_req zone=login burst=5 nodelay;
#       limit_req_status 429;
#   - 写类/敏感端点：同上换 zone=strict burst=10。
#   注意事项（缺一条都会失效或偏航）：
#     1) 新 location 必须**完整重声明** proxy 头与超时（见下方「反向代理头」段——
#        嵌套块整体替换语义，漏一条等于该块没有）；
#     2) 正则 location 的优先级高于 /api/ 前缀块，路径按实际路由写，别用会误伤的宽正则；
#     3) 启用前同步 src/tests/deploy/nginxProxyContract.test.js 的限速落点期望表，
#        否则契约测试会按「意外携带 limit_req」报红——这是有意的评审闸，不是障碍。

# ===== 访问日志：只记路径，不记查询串（2026-10-24 审计 finding）=====
# nginx 默认的 combined 格式含 `$request`，即「方法 + 完整 URI + 协议」——查询串
# 一并落盘。本系统里查询串可能携带一次性凭据（密码重置令牌、邮件验证 token、
# 登录票据），它们会被轮转进日志文件并按留存期长期存在，读日志的人即可重放。
# `$uri` 是归一化后的**路径**，不含 `?args`；排障确需参数时临时加 `$args`，
# 排查完撤掉（长期开启等于把同一份凭据再抄一遍到磁盘）。
# 反向代理到后端时后端仍会看到完整 URI，这里只约束「nginx 自己写什么」。
log_format fsms_no_query '$remote_addr - $remote_user [$time_local] '
                         '"$request_method $uri $server_protocol" '
                         '$status $body_bytes_sent "$http_referer" "$http_user_agent"';
access_log /var/log/nginx/access.log fsms_no_query;
#
# ── 取证日志格式（2026-10-31；默认不挂线）──────────────────────────────────────
# 定位：DDoS/爆破窗口的**离线取证**，与 P2 捕获管道互为备份——后者按 P1 标记表
# （src/services/forensicTrigger.js）决定是否升级为全量捕获。字段与应用侧捕获对齐：远端地址 /
# XFF 原链 / 方法 / 原始 URI / 状态 / TLS 参数 / UA / sec-ch-ua / 请求耗时 / 上游耗时；
# 应用侧采样或降级时 nginx 侧仍完整。
# 与 fsms_no_query 的取舍（先读懂再启用）：本格式**含 $request_uri（带查询串）**，
# 查询串里可能有一次性凭据（重置令牌等），所以默认**不挂线**；只在攻击窗口按需启用，
# 窗口结束立即改回注释并轮转/删除 forensic.log（启用/关闭步骤与观察口径见
# deployment/edge-protection.md 的「取证窗口」一节）。
# 字段说明：$http_x_forwarded_for 保留**原链文本**（不解析、不截断，应用侧同口径）；
# $ssl_protocol/$ssl_cipher 与两条 X-Tls-* 头同源（同一次 TLS 会话）；上游未到/超时
# 时 $upstream_response_time 记 -，别把它当 0 用。
log_format fsms_forensic '$remote_addr $http_x_forwarded_for [$time_local] '
                         '"$request_method $request_uri $server_protocol" $status '
                         'tls=$ssl_protocol/$ssl_cipher ua="$http_user_agent" '
                         'ch="$http_sec_ch_ua" rt=$request_time urt=$upstream_response_time';
# 启用（默认注释；窗口结束改回）：取消下一行注释即开始写 forensic.log
# access_log /var/log/nginx/forensic.log fsms_forensic;

# ── 升级：蓝绿 upstream（2026-10-30）───────────────────────────────────────
# 切流 = 改「哪一行被注释」+ `nginx -t && nginx -s reload`。
# reload 只影响新连接（worker 平滑换代），既有 keepalive 连接被优雅关闭，
# 实测中断 < 100ms。回滚就是把注释改回来再 reload——旧色容器在观察期内
# **保持运行**，这是回滚能成立的前提，脚本不会在观察期结束前停它。
#
# 为什么必须用 upstream 而不是在这里写两个地址让 nginx 轮询：
# 两色跑的是**不同版本**，轮询会让同一次页面加载的前后端请求落在不同版本上。
# N-1 兼容只保证「不 500」，不保证语义一致（例如新版本改了某个统计口径，
# 用户会看到同一页里两个数字互相矛盾）。切流必须是原子的「全切」。
#
# 不变量：本块内**有且只有一行**未注释的 server。两行都放开 = 轮询混跑；
# 都不放开 = 502。scripts/hotUpgrade.js 的 parseActiveUpstream 会对这两种
# 形态直接报错，不做猜测。
#
# 本文件全部 7 处 proxy_pass（含 /socket.io/）都指向 fsms_app。改这里之前先确认
# 没有哪处需要固定打某一色——目前没有这样的端点：/metrics 由 Prometheus 在容器
# 网络内直连 app:3000 抓取，不经本层。
upstream fsms_app {
    server 127.0.0.1:3000;    # 当前色 blue：compose 服务 app
    # server 127.0.0.1:3001;  # 备色 green：compose 服务 app-green（仅升级窗口内存在）
    # 注意：3001 也是 Grafana 声明的宿主端口，故 Grafana 已移入 observability profile
    # （默认栈不含它）。升级窗口内不要 `--profile observability` 起 Grafana，否则第 2 步
    # 起备色会撞端口：Bind for 127.0.0.1:3001 failed: port is already allocated。
}

# HTTP -> HTTPS 强制跳转
server {
    listen 80;
    listen [::]:80;
    server_name your-domain.example;
    # 不对外暴露 nginx 版本（403/404 错误页与 Server 头都会带）。
    # 与后端 app.disable('x-powered-by') 同一口径：不把栈信息白送给指纹匹配者。
    server_tokens off;
    # 跳转目标写字面域名，不用 $host：$host 取自请求的 Host 头，而本块是 :80 的
    # 默认 server（唯一声明该端口的块自动成为默认；:443 侧因存在多个块，默认身份
    # 由文末的 default_server 兜底块**显式**声明——两个端口的机制不同，见文末注释），
    # 因此任何解析到本机的域名都会被
    # 它接管并发出 `301 https://evil.com/...`——开放重定向，可直接用于钓鱼；
    # 配合上面的 HSTS preload 危害更大。$request_uri 只含路径/查询，不含主机，安全。
    return 301 https://your-domain.example$request_uri;
}

# HTTPS 主入口
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name your-domain.example;
    server_tokens off;

    # ===== TLS 证书（使用受信任 CA 签发，勿用自签名） =====
    ssl_certificate     /etc/nginx/certs/your-domain.example.fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/your-domain.example.key.pem;

    # ===== 强化 TLS 参数 =====
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384;
    ssl_prefer_server_ciphers on;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;
    # OCSP stapling（需 CA 签发证书且链中含 OCSP 地址；自签名证书请保持注释）
    # ssl_stapling on;
    # ssl_stapling_verify on;
    # ssl_trusted_certificate /etc/nginx/certs/your-domain.example.chain.pem;
    # resolver 223.5.5.5 119.29.29.29 valid=300s;
    # resolver_timeout 5s;

    # ===== HSTS（仅在 HTTPS 上下发才有意义；确认全站 HTTPS 后再启用 preload） =====
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" always;

    # ===== 全套安全响应头 =====
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "same-origin" always;
    # 与后端 helmet xssFilter 口径一致：主动禁用有绕过历史的旧版 XSS Auditor（值 0），
    # XSS 防护由 CSP + 框架转义承担；现代浏览器已忽略该头，仅为兼容性工具下发
    add_header X-XSS-Protection "0" always;
    add_header Cross-Origin-Opener-Policy "same-origin" always;
    add_header Cross-Origin-Resource-Policy "same-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), magnetometer=(), gyroscope=(), accelerometer=()" always;
    # ===== CSP 分工（finding #6 改写）=====
    # 浏览器对同一响应携带的**多个** CSP 取交集（每个策略都须放行，响应里被任一策略
    # 禁止的资源即被拦）——交集问题只发生在「一个响应、两个 CSP」，因此按路径划分
    # 谁下发即可，不存在全文件级的「不许加 CSP」：
    #   - 反代路径（下方所有 proxy_pass 块）：响应由后端 src/middleware/security.js
    #     按每请求下发 CSP——style-src 带每请求随机 nonce，仅 /api-docs(Swagger)
    #     放行 'unsafe-inline'。本文件在 server 级与这些 location **都不加** CSP：
    #     静态策略没有 nonce，一旦叠加就会把后端放行的内联样式全部拦掉。
    #   - 静态直出路径（location / 与 /assets/，含 SPA fallback）：请求根本不到后端，
    #     上述 nonce CSP 永远不会出现——这两处必须在 nginx 侧各自下发静态 CSP
    #     （见下方两块。L-09：add_header 在嵌套块是整体替换，故连同安全头整套重声明）。

    # ===== 传输压缩（gzip + 可选 brotli） =====
    # element-plus / echarts chunk 体积较大，压缩后首屏传输量通常降低 60%–75%。
    # gzip_static / brotli_static 优先使用构建期预压缩文件（.gz/.br），避免每次请求实时压缩。
    gzip on;
    gzip_vary on;
    gzip_comp_level 6;
    gzip_min_length 1024;
    gzip_proxied any;
    gzip_types
        text/plain text/css text/xml text/javascript
        application/javascript application/json application/xml
        application/xml+rss application/manifest+json
        image/svg+xml font/ttf font/otf;
    gzip_static on;

    # brotli 需 ngx_brotli 模块，未编译时注释掉以下三行即可
    # brotli on;
    # brotli_comp_level 5;
    # brotli_types text/plain text/css text/javascript application/javascript application/json application/manifest+json image/svg+xml;
    # brotli_static on;

    # ===== 前端静态资源（web-admin/dist） =====
    root /var/www/fire-safety/web-admin/dist;
    index index.html;

    # 纵深拦截 sourcemap / 源码文件（与 src/middleware/staticFrontend.js 的
    # DENIED_STATIC_EXTS 同口径 —— 两条托管路径是二选一，只在一侧设防等于没设）。
    # 构建目前关 sourcemap，这里防的是配置漂移后产物里出现 .map/.ts 仍被公网取到。
    #
    # 为什么单开一个正则块而不是往下面的 location / 里加 if：
    #   - 正则 location 的优先级高于前缀 location（`=` 与 `^~` 除外），所以本块
    #     一定先于 location / 与 location /assets/ 生效，不需要靠写法顺序赌运气；
    #   - `~*` 大小写不敏感：Windows/开发机上 leak.js.MAP 命中同一文件，
    #     只判小写等于留一个平台相关的缺口；
    #   - 404 响应不需要 /assets/ 那套安全头/缓存头（见下面 L-09 注释：add_header
    #     在嵌套块里是整体替换），所以本块不写 add_header，也不该写。
    location ~* \.(map|ts)$ {
        return 404;
    }

    # SPA 直出（含 try_files 退到 /index.html 的 fallback）：不经过后端 CSP 中间件，
    # 因此这里整套重声明安全头并新增静态 CSP（finding #6）。任何一条 add_header 出现
    # 都会关掉对 server 级头的继承（L-09），所以是整套而非只写 CSP。
    location / {
        try_files $uri $uri/ /index.html;
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header Referrer-Policy "same-origin" always;
        add_header X-XSS-Protection "0" always;
        add_header Cross-Origin-Opener-Policy "same-origin" always;
        add_header Cross-Origin-Resource-Policy "same-origin" always;
        # 全局 noindex 的 nginx 直出面补位（审计 2026-11-02 F-4）：SPA 登录页是
        # 最可收录的组织指纹面，而它不经 Node（securityHeaders 的 X-Robots-Tag
        # 够不到这里）。L-09 整体替换语义 ⇒ 本块必须与其它头并列重声明。
        add_header X-Robots-Tag "noindex, nofollow" always;
        add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), magnetometer=(), gyroscope=(), accelerometer=()" always;
        # 静态 CSP（finding #6）取值证据：
        #   - script-src 'self'：构建产物 dist/index.html 全部为外链 script（vite 默认
        #     不产内联 script，实测产物三个 script 均带 src），首帧主题脚本
        #     theme-bootstrap.js 也是同源外链（index.html 模板注释明说「外链保证生产
        #     CSP(script-src 'self')」）；生产不含 'unsafe-eval'：vue-i18n 走预编译产物
        #     （vite.config.js 同口径）。
        #   - style-src 保留 'unsafe-inline' 与 fonts.googleapis.com：global.css 以
        #     @import 引入 Google Fonts（style-src 须放行其样式表）；element-plus 等组件
        #     库在运行时经 style 属性/注入做定位与主题，去掉 'unsafe-inline' 会静默破坏
        #     组件渲染。整体与 web-admin/vite.config.js buildSecurityHeaders 的生产 CSP
        #     （vite preview 直跑 dist、已被前端侧验证）保持同源，避免两条托管路径分叉。
        #   - font-src data: 与 fonts.gstatic.com：上述 @import 对应的字体文件域；
        #     img-src blob: 同样对齐 vite 生产 CSP（本地对象 URL 预览场景）。
        #   - connect-src 'self'：/api 与同源 wss /socket.io/ 均走本域（CSP3 起 'self'
        #     覆盖同源 ws/wss；vite 生产 CSP 的 L8 注释同口径）。若启用 VITE_SENTRY_DSN
        #     扇出（errorReporter 动态加载），须另行放行对应 ingest 域，否则被本策略拦截。
        #   - frame-ancestors 'none'：与本 server 的 X-Frame-Options DENY 同口径（比
        #     vite preview 的 'self' 更严；DENY 只管传统 frame，这是 CSP 标准指令）。
        #   - sw.js/registerSW.js 也经本块直出并携带同一 CSP：与 vite preview 生产行为
        #     一致（该基线已在用），文档上下文的策略不受子资源响应上的 CSP 头影响。
        add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: blob:; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'" always;
    }

    # 构建产物带内容哈希，可长期强缓存；index.html 不缓存以保证发版即时生效
    #
    # 【L-09 修复】nginx 的 add_header 在嵌套块中是**整体替换**而非继承：只要本块
    # 出现一条 add_header，server 级下发的 HSTS / X-Frame-Options / X-Content-Type-Options
    # / COOP / CORP / Permissions-Policy 在 /assets/ 路径上会**全部消失**（实测复现）。
    # 因此这里必须把安全头整套重声明一遍。**改动 server 级清单或 location / 的重声明
    # 时请同步本块**——静态头现在有三份副本（server 级 + 两条直出 location 各一套，
    # finding #6 之后直出套还各多一条静态 CSP），缺一份就是一条静默退化的路径。
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable" always;
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header Referrer-Policy "same-origin" always;
        add_header X-XSS-Protection "0" always;
        add_header Cross-Origin-Opener-Policy "same-origin" always;
        add_header Cross-Origin-Resource-Policy "same-origin" always;
        # 与 location / 同款 noindex 补位（L-09 ⇒ 两块都要显式重声明，见其块内注释）
        add_header X-Robots-Tag "noindex, nofollow" always;
        add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), magnetometer=(), gyroscope=(), accelerometer=()" always;
        # 静态 CSP（finding #6）：与 location / 为**同一份**策略（取值证据见其块内
        # 注释），由契约测试断言两条副本逐字节一致——只改一条 = 另一条静默漂移。
        add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: blob:; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'" always;
    }

    # ===== 反向代理头：每个 proxy 块必须**完整重声明**基础四条 + TLS 取证两条 =====
    #
    # 两条 nginx 语义决定了不能只在 server 级写一遍：
    #   1. proxy_set_header 在嵌套块中是**整体替换**而非继承/追加——只要本块出现
    #      任意一条 proxy_set_header，外层声明就全部失效（与上方 /assets/ 的
    #      add_header 同一套语义，见 L-09 说明）；
    #   2. 未声明 Host 时 nginx 默认发 `Host: $proxy_host`，即 proxy_pass 的目标地址
    #      127.0.0.1:3000，而不是用户实际访问的域名。
    #
    # 第 2 条在本项目是功能性缺陷而非风格问题：ALLOWED_HOSTS 为生产必填项
    # （src/config/validate.js 的 M3），protocolCompliance 用 req.get('host') 与之
    # 精确比对，且经 app.js applyPreBodySecurity 挂在 body 解析之前覆盖全站，
    # skipPaths 仅豁免 '/health'。缺 Host 时 /metrics 抓取、/csp-report 与
    # /client-errors 上报、/socket.io/ 握手一律得到 400 HOST_HEADER_INVALID。
    # 这些端点不经过 nginx 就测不到（supertest 直连 app），CI 完全抓不住。
    #
    # X-Real-IP / X-Forwarded-For 同理不可省：TRUST_PROXY_HOPS 默认 1
    # （docker-compose.yml），应用侧的限流、IP 黑名单与审计来源都取 req.ip（可信边界判据见下段）。
    # 少传时该通道上所有客户端在应用侧塌缩成同一个 IP（F-10 的反代版本），
    # 限流与封禁对其失效，审计里的来源 IP 也是假的。
    #
    # 一致性由 src/tests/deploy/nginxProxyContract.test.js 把守（新增 proxy 块漏头即红）。
    #
    # 【2026-10-31 取证加固：TLS 取证两条】基础四条之外，每个反代块再声明：
    #   proxy_set_header X-Tls-Protocol $ssl_protocol;
    #   proxy_set_header X-Tls-Cipher $ssl_cipher;
    # 用途：应用侧取证捕获（P2，按 P1 标记表 src/services/forensicTrigger.js 升级）从 x-tls-protocol /
    # x-tls-cipher 读客户端 TLS 会话参数；缺失时应用侧记 null（不推断）。TLS 在本层终结，
    # 这两条头是应用唯一可见的来源，故与基础四条同规格：嵌套块整体替换语义下，必须
    # 逐块重声明（漏一块＝那条通道的捕获缺 TLS 字段）。
    #
    # 【2026-11-01 上游指纹抹除：proxy_hide_header】每个反代块再声明一行：
    #   proxy_hide_header X-Powered-By;
    # server_tokens off 只抹 nginx 自己的 Server 头；上游响应里的框架指纹由本行在
    # 本层抹除。应用侧已有 app.disable('x-powered-by')，本行是纵深——防「未来链路
    # 新增上游组件/新色后端重新带出该头」这类静默回归。它同样是逐块生效的指令
    # （不属于 add_header 的整体替换语义，但新增 proxy 块时须一并带上）。
    #
    # 【2026-10-31 XFF 信任边界口径（与应用层 clientIpForSecurityDecision 的 N 跳对齐）】
    # 本层用**追加式** $proxy_add_x_forwarded_for（保留请求方自带的左段 + 追加本层看到的
    # $remote_addr），并用 X-Real-IP $remote_addr 单独给出 TCP 对端。应用侧 TRUST_PROXY_HOPS
    # 默认 1（docker-compose.yml）：Express/proxy-addr 取 XFF **最右一跳**作为 req.ip，
    # 正常路径下即本层追加的真实客户端。但最终口径在 utils/ipUtils.clientIpForSecurityDecision：
    # trust proxy 开启且带 XFF 时，先要求 socket 对端 ∈ TRUSTED_PROXY_CIDRS（对端须是代理
    # 才信 XFF），否则退回**不可伪造的 socket 对端**。由此两条部署不变量：
    #   1) TRUST_PROXY_HOPS 必须等于实际代理层数（本拓扑恒为 1）。调大＝允许请求方自带的
    #      XFF 左段参与判定，伪造即成功——该风险已在 src/middleware/rateLimit.js 与
    #      src/middleware/security/ipBlacklist.js 的注释里登记，改前先读；
    #   2) 应用端口只对本层（或等价网关）可达，且 TRUSTED_PROXY_CIDRS 覆盖本层对端网段
    #      （compose 已把 app 端口钉在 127.0.0.1 且该变量强制必填）。绕过本层直连 app:3000
    #      的请求在应用侧退回 socket 对端——限流/封禁/审计口径才不会被 XFF 伪造带走。
    # 结论：改本文件任何 XFF 相关行之前，先对齐 utils/ipUtils 的判据本体与
    # docs/threat-model.md 的 F-01 残余风险；两边的「N 跳」口径必须一起改。
    #
    # 反代超时（finding #10）：每个反代块都显式声明 connect/send 超时，不依赖
    # nginx 默认值——上游 nginx.conf 的静默变更不应改变本文件的边缘语义。
    #   - proxy_connect_timeout 5s：上游是 127.0.0.1:3000，TCP connect 毫秒级，
    #     5s 已极宽松；上游打满时快速失败（502）优于让客户端按默认 60s 干等。
    #   - proxy_send_timeout：短请求块取 30s（请求体 ≤1MB、回环写入毫秒级）；
    #     socket.io 取 60s——升级后的隧道里该计时器由「客户端→上游」方向的数据
    #     刷新，socket.io 默认 25s 心跳（pingInterval）保证有流量，60s 留足抖动
    #     余量（取 30s 会把慢网络下正常的心跳间隙误判为僵死连接）。
    #   - proxy_read_timeout：/api 两条入口显式钉住默认 60s（见其块内注释），
    #     其余短请求块沿用同一默认值；socket.io 300s 是僵死连接回收闸（见其块）。

    # ===== Prometheus /metrics（无 Nginx 层鉴权端点，必须限制抓取来源） =====
    # 应用侧默认只放行内网/回环来源；但本 Nginx 转发到后端时对端恒为回环，
    # 故 TRUST_PROXY_HOPS>0 下应用层要求经代理的 /metrics 携带 METRICS_TOKEN：
    # 抓取方需发送 `Authorization: Bearer $METRICS_TOKEN`，否则一律 401。
    # 容器网络内 Prometheus 直连 app:3000（shipped prometheus.yml）不受影响。
    # 按实际监控主机/网段调整 allow 列表。
    location = /metrics {
        allow 127.0.0.1;
        allow 10.0.0.0/8;        # ← 改成实际监控采集网段
        deny all;
        # connect/send 超时口径见上方「反向代理头」段落（finding #10）
        proxy_connect_timeout 5s;
        proxy_send_timeout 30s;
        proxy_pass http://fsms_app;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Tls-Protocol $ssl_protocol;
        proxy_set_header X-Tls-Cipher $ssl_cipher;
        # 上游指纹抹除（说明见上方「反向代理头」段）
        proxy_hide_header X-Powered-By;
    }

    # ===== 无认证上报端点（根路径，静态托管不能吞掉）=====
    # /csp-report（CSP 违规）、/client-errors（前端异常/Web Vitals，G-1）
    # 均由浏览器自动发起、无法带认证；后端自带独立限流
    location ~ ^/(csp-report|client-errors)$ {
        # connect/send 超时口径见上方「反向代理头」段落（finding #10）
        proxy_connect_timeout 5s;
        proxy_send_timeout 30s;
        proxy_pass http://fsms_app;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Tls-Protocol $ssl_protocol;
        proxy_set_header X-Tls-Cipher $ssl_cipher;
        # 上游指纹抹除（说明见上方「反向代理头」段）
        proxy_hide_header X-Powered-By;
    }

    # ===== 安全联络策略（RFC 9116）=====
    # 后端把 security.txt 挂在**根路径**（app.js 的 app.use('/', wellKnownRoutes) →
    # GET /.well-known/security.txt 与 GET /security.txt），而本 server 的 root 指向前端
    # dist：没有这两条反代时上面的 location / 会用 try_files 退到 /index.html，
    # 生产域名上返回 200 的 SPA HTML 而非文本——对外承诺的漏洞披露渠道静默失效，
    # 且因为"200 且是 HTML"，监控与人工访问都不容易发现。
    # 用 regex 而非 ^~ /.well-known/：后者会把 ACME http-01 挑战（/.well-known/acme-challenge/）
    # 一并转给后端，签单即失败。
    location ~ ^/(?:\.well-known/)?security\.txt$ {
        # connect/send 超时口径见上方「反向代理头」段落（finding #10）
        proxy_connect_timeout 5s;
        proxy_send_timeout 30s;
        proxy_pass http://fsms_app;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Tls-Protocol $ssl_protocol;
        proxy_set_header X-Tls-Cipher $ssl_cipher;
        # 上游指纹抹除（说明见上方「反向代理头」段）
        proxy_hide_header X-Powered-By;
    }

    # ===== 后端 API 反向代理（TLS 在此终结，后端可走明文内网） =====
    location /api/ {
        # 边缘限流（finding #10 / 2026-10-31 三档）：zone 取值依据与 login/strict 档启用模板见文件顶部 limit_req_zone 段。
        # 只落在 /api 的两条入口——/socket.io/ 长连接语义不同（见其块内注释）刻意豁免；
        # 上报端点由后端独立限流、/metrics 有 ACL、/health 是探针，都不在本闸范围。
        limit_req zone=general burst=20 nodelay;
        # 与后端 express-rate-limit 的 429 语义对齐（nginx 默认 503 会误导客户端退避
        # 逻辑与监控告警口径）。
        limit_req_status 429;
        # 上游在回环地址：connect 毫秒级，5s 已极宽松；read/send 是把 nginx 默认值
        # 显式钉在本文件，防上游 nginx.conf 静默变更（socket.io 的 300s 是长连接特例）。
        proxy_connect_timeout 5s;
        proxy_send_timeout 30s;
        proxy_read_timeout 60s;
        proxy_pass http://fsms_app;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Tls-Protocol $ssl_protocol;
        proxy_set_header X-Tls-Cipher $ssl_cipher;
        # 上游指纹抹除（说明见上方「反向代理头」段）
        proxy_hide_header X-Powered-By;
    }

    # 前缀块 `location /api/` 匹配不到**不带斜杠**的 `/api`，而它是一条真实路由
    # （app.js:518 返回 `{"success":true,"message":"消防管理系统 API"}`）：
    # 少了本块，`https://域名/api` 会落到 location / 的 try_files，
    # 用 200 的 SPA HTML 回答一个 API 路径请求——客户端解析 JSON 直接炸，
    # 且炸在业务层而不是网关层，排查成本极高。
    # 写成独立的 `=` 精确块而不是把上面的前缀改成 `/api`：后者会连带匹配
    # `/apixyz.html` 这类未来的静态资源，把不该转发的请求也代理走。
    # 已知取舍：app.js 的 ipLimiter/generalLimiter/auditLog 挂在 `app.use('/api/')` 下，
    # 该精确路径不经过它们（全站级的 checkIPBlacklist 与 protocolCompliance 仍在）。
    # 应用侧的限流缺口由网关侧补齐：本块与 /api/ 共用同一条 limit_req（finding #10 / general 档，
    # 取值依据见文件顶部）——响应虽是常量 JSON，边缘闸的本意也是让扫描器的侦察请求
    # 付出速率代价。若将来它变成有状态的端点，
    # 必须改挂到 /api/ 前缀之下而不是继续扩大本块。
    location = /api {
        limit_req zone=general burst=20 nodelay;
        limit_req_status 429;
        proxy_connect_timeout 5s;
        proxy_send_timeout 30s;
        proxy_read_timeout 60s;
        proxy_pass http://fsms_app;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Tls-Protocol $ssl_protocol;
        proxy_set_header X-Tls-Cipher $ssl_cipher;
        # 上游指纹抹除（说明见上方「反向代理头」段）
        proxy_hide_header X-Powered-By;
    }

    # /health 本身在 protocolCompliance 的 skipPaths 内（Host 校验豁免），
    # 这里仍按同一口径补齐四条：豁免是中间件的默认参数而非契约，且探针的
    # 来源 IP 同样要进审计。/readyz 刻意不对外——见下方 `= /readyz` 块。
    location /health {
        # connect/send 超时口径见上方「反向代理头」段落（finding #10）
        proxy_connect_timeout 5s;
        proxy_send_timeout 30s;
        proxy_pass http://fsms_app;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Tls-Protocol $ssl_protocol;
        proxy_set_header X-Tls-Cipher $ssl_cipher;
        # 上游指纹抹除（说明见上方「反向代理头」段）
        proxy_hide_header X-Powered-By;
    }

    # ===== 就绪探针：显式 404，不得落到 SPA 兜底（2026-10-24）=====
    # 此前本文件只写了「/readyz 刻意不对外」的**注释**，配置上却没有任何对应指令：
    # /readyz 匹配不到任何 location，落进 location / 的 try_files ⇒ 返回
    # **200 + SPA 的 index.html**。两种真实伤害：
    #   1. 假绿探针：外部拨测/云监控若配了这个地址，会永远绿——它实际探的是
    #      "nginx 能不能返回 index.html"，而不是"MongoDB 可不可达"。健康检查
    #      永远成功比没有健康检查更坏（编排器永远不会摘流量）。
    #   2. 承诺与配置相反：注释声称已关闭，部署方据此认为该端点不可达，
    #      于是也不会去核对它是否真的被关闭。
    # 为什么是 404 而不是 403：403 等于向扫描器确认"这个路径存在且被保护"，
    # 与上方 .map/.ts 的处理同口径，不提供存在性信号。
    # 为什么可以直接拒：容器 HEALTHCHECK 与 compose 探针直连 app:3000，
    # 不经过本文件（见 Dockerfile 的 HEALTHCHECK 与 docker-compose.yml）。
    # 若将来确需外部 LB 探 /readyz，**不要删掉本块**——改成 allow 白名单 + proxy_pass
    # （参考 `= /metrics` 的写法），删掉即回到 200 HTML 的假绿。
    # 契约由 src/tests/deploy/nginxProxyContract.test.js 把守。
    location = /readyz {
        return 404;
    }

    # ===== 网关错误页接管（参考研读 2026-11-01 §二 P0-2） =====
    # 502/504 是用户唯一绕过应用层、直接撞上 nginx 默认白页的路径——白页无指引、
    # 无品牌、被截图即成"系统挂了"的证据。三步接管（SafeLine 同款骨架，见其
    # IF_backend_1 的 error_page 体系）：
    #   1) 497（明文请求打到 HTTPS 端口）→ 302 到字面域名的 https 地址，把最扫兴的
    #      协议错误变成无感跳转。跳转目标与 :80 的 301 同一纪律：写**字面域名**，
    #      不用 $host（Host 头可伪造，见 :80 块注释）；$request_uri 只含路径/查询，
    #      不含主机，可安全回带。
    #   2) 502/504 → internal 重定向到自包含错误页（零外部请求、noindex，见
    #      deployment/gateway-pages/gateway-error.html）。部署时把该目录同步到宿主、
    #      保持下方 alias 路径一致；文件缺失时本层对内部重定向返回 404——
    #      上线清单必须包含「错误页文件已就位」一项（deployment 文档同步登记）。
    #   3) 错误页 location 无 add_header（继承 server 级安全头）、无 CSP（CSP 只落
    #      两条静态直出块，见 finding #6 契约）、无 proxy_pass（不构成第二个入口）。
    # 429 不在此接管：应用层限流的 429 有结构化 JSON 语义与前端话术；边缘
    # limit_req 的 429 也由前端按状态码处理。「排队/降级页」是独立演进项
    # （deliverables/参考项目研读与优化报告-2026-11-01.md P2-5），不与本段混做。
    error_page 497 =302 https://your-domain.example$request_uri;

    error_page 502 504 /_gateway_error.html;
    location = /_gateway_error.html {
        internal;
        # 部署时与 deployment/gateway-pages/ 保持同步（路径按宿主布局调整）
        alias /var/www/fire-safety/gateway-pages/gateway-error.html;
    }

    # ===== WebSocket（wss，同源） =====
    # 刻意**不加** limit_req（finding #10 范围说明）：WebSocket/长轮询是长连接语义，
    # 握手后消息复用同一逻辑连接，按请求数计的令牌桶表达不了「连接数」，还会误伤
    # long-polling 兜底传输；此处的资源闸是应用侧 MAX_CONNECTIONS_PER_PROCESS=1000（单进程）与下方
    # 300s 读超时（回收僵死连接），语义各自对位。
    location /socket.io/ {
        proxy_pass http://fsms_app;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Tls-Protocol $ssl_protocol;
        proxy_set_header X-Tls-Cipher $ssl_cipher;
        # 上游指纹抹除（说明见上方「反向代理头」段）
        proxy_hide_header X-Powered-By;
        # connect/send 口径见上方「反向代理头」段落（finding #10）：send 取 60s
        # 是心跳余量（非短请求块的 30s）；read 300s 回收闸保持不动。
        proxy_connect_timeout 5s;
        proxy_send_timeout 60s;
        proxy_read_timeout 300s;
    }
}

# ===== 443 兜底块（finding #10）：未被上方命中的 SNI/Host 一律拒绝 =====
# 此前 :443 只有主入口一个块，它自动成为该端口的默认 server——IP 直连扫描、证书透明度
# 爬虫、任意伪造 SNI/Host 的客户端都能完成 TLS 握手并拿到整套 SPA 产物与安全头指纹。
# 本块把默认身份显式抢过来：
#   - ssl_reject_handshake on（nginx ≥1.19.4；本文件因主块 `http2 on` 已要求 ≥1.25.1）：
#     对未匹配 SNI 直接断开握手，因此本块**不需要**证书，也不会响应任何应用层内容；
#   - return 444 是纵深：若 ssl_reject_handshake 被旧版本环境移除，HTTP 层直接断连
#     而不是给出可探测的响应；
#   - server_name _ 与主块的字面域名互斥，不会抢占正常流量；
#   - 无 root / 无 proxy_pass：兜底块不得携带任何可服务内容，否则等于第二个入口。
# 与 :80 的差别（见 :80 块注释）：:80 的默认身份靠「唯一声明该端口的块」隐式成立，
# :443 因为存在两个块，必须显式 default_server。契约由 nginxProxyContract.test.js 把守。
server {
    listen 443 ssl default_server;
    listen [::]:443 ssl default_server;
    server_name _;
    server_tokens off;
    ssl_reject_handshake on;
    return 444;
}
