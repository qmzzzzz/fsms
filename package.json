{
  "name": "fire-safety-rbac-system",
  "version": "1.0.0",
  "description": "基于权限管控的消防管理系统",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "lint": "eslint src scripts e2e eslint.config.js",
    "lint:ratchet": "node scripts/lint-ratchet.js",
    "lint:web": "npm --prefix web-admin run lint",
    "lint:all": "npm run lint && npm run lint:ratchet && npm run lint:web",
    "format": "prettier --write docs deliverables deployment CHANGELOG.md README.md docker-compose.yml package.json web-admin/package.json .github src scripts migrations migrate-mongo-config.js web-admin/src e2e playwright.config.js",
    "format:check": "prettier --check docs deliverables deployment CHANGELOG.md README.md docker-compose.yml package.json web-admin/package.json .github src scripts migrations migrate-mongo-config.js web-admin/src e2e playwright.config.js",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:watch": "jest --watch",
    "test:e2e": "node scripts/e2e-smoke.js",
    "test:e2e:browser": "playwright test",
    "test:prod-drill": "node scripts/production-drill.js",
    "test:load": "node scripts/load-test.js",
    "validate": "node src/config/validate.js",
    "security:audit": "npm audit --audit-level=high --omit=dev && node scripts/compliance-check.js",
    "security:audit:prod": "npm audit --audit-level=high",
    "rotate:mfa-secret": "node scripts/migrate-mfa-secret.js",
    "rotate:audit-hmac": "node scripts/resign-audit-hmac.js",
    "rotate:audit-chain-v3": "node scripts/resign-audit-chain-v3.js",
    "drill:rollback": "node scripts/run-rollback-drill.js",
    "migrate:create": "migrate-mongo create",
    "migrate:status": "migrate-mongo status",
    "migrate:up": "migrate-mongo up",
    "migrate:down": "migrate-mongo down"
  },
  "keywords": [
    "fire-safety",
    "rbac",
    "permission-control",
    "security"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@sentry/node": "^7.100.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "bcryptjs": "^2.4.3",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "hpp": "^0.2.3",
    "ioredis": "^6.0.0",
    "ipaddr.js": "^2.5.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^9.10.1",
    "morgan": "^1.12.1",
    "rate-limit-redis": "^4.3.1",
    "socket.io": "^4.8.3",
    "svg-captcha": "^1.4.0",
    "swagger-ui-express": "^5.0.1",
    "ua-parser-js": "1.0.41",
    "winston": "^3.11.0",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "overrides": {
    "uuid": "^11.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.62.1",
    "eslint": "^9.39.5",
    "jest": "^29.7.0",
    "migrate-mongo": "^14.0.7",
    "mongodb-memory-server": "^11.2.0",
    "nodemon": "^3.0.2",
    "prettier": "^3.9.6",
    "supertest": "^6.3.3"
  }
}
