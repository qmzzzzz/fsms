# 环境变量（覆盖所有 .env 变体，模板文件 .env.example 除外）
.env
.env.*
!.env.example

# 依赖
node_modules/
web-admin/node_modules/

# 全局 npm 包（按用户主目录生成，避免硬编码本机用户名）
**/AppData/Roaming/npm/

# 日志
logs/
*.log
npm-debug.log*

# 测试
coverage/
.nyc_output/
playwright-report/
test-results/
# jest 的**手工 cacheDirectory** 产物：`jest.config.js` 里没有这项配置，是某会话为绕开
# 本机 `EPERM …%TEMP%\jest\haste-map-*` 而临时传 `--cacheDirectory=.jest-cache-laneA` 留下的。
# 曾残留 309 个文件 / 9.3MB 二进制缓存，`git add -A` 会一并收进仓库。
.jest-cache-*/

# 备份/编辑器残留
*.bak

# 数据备份产物（#4）：scripts/backup-mongo.sh 输出目录 backups/、
# run-rollback-drill.js 产出的含口令哈希/mfaSecret/审计日志的 *.ndjson.gz，
# 以及任何私钥文件（.pem/.key，含 .env.example 引导生成的 login_ecdh_private.pem）
backups/
*.ndjson.gz
*.pem
*.key

# 构建
web-admin/dist/
# 前端覆盖率的**带后缀变体**：上面 `coverage/` 只匹配名为 coverage 的目录，
# 匹配不到 `coverage-zzmfa` / `coverage-zzmfa-before` / `coverage-zzmc1` 这类
# 手工跑覆盖率时用 `--reporter=... --coverageDirectory=coverage-<tag>` 起的对照目录。
web-admin/coverage-*/
dist/
build/

# 系统文件
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# Windows 快捷方式与回收站
*.lnk
$RECYCLE.BIN/

# 临时文件
*.tmp
.temp/
# 修复：匹配 .tmp- 前缀的临时脚本/日志文件（如 .tmp-e2e-captcha-off.js）
.tmp-*

# 审计中间产物（2026-09-16 报告 §12.2）：含本机绝对路径与源码片段，不入库。
# 保留文件本体供复跑（附录 A 探针清单可重跑复现），只是不再进 git 视野。
.audit-*

# 临时对抗性探针（P1-30）：命名约定 zzz-* 的探针不得入库。
# 原 8 个 zzz-*.test.js（591 行 / 51 test / 0 expect，且两处打印完整 JWT）已于
# 2026-09-17 删除；保留本规则作为防复发守卫，避免 `git add .` 把同类
# 0 断言的临时探针提交进仓库。

# 后台任务输出（不硬编码本机用户名）
**/AppData/Local/Temp/claude/*

# 自签名 TLS 证书（scripts/generate-dev-cert.sh 生成目录）
certs/

# 密钥文件目录（P3-48：docker-compose secrets 的挂载源，含 JWT/AES/DB 口令）
# 目录本身与其中任何文件都绝不能入库
secrets/


# 首次启动生成的管理员初始口令文件（initData 写入，绝不能入库）
.admin-initial-password

# 工具/会话内部状态（非项目代码，不入库）
.mimosa/

# 会话工具生成的完整性快照（引用被忽略文件，新克隆无法复现，不入库）
.merkle-snapshot.json

# 会话工具内部记忆（非项目代码）
.workbuddy/
# 设计参考资产副本（工具技能产物，如需入库可移除本行）
.design_library/
# 前端构建产物变体
web-admin/dist-optimized/

# CI 调试脚本与运行日志（M-03：曾误入库，含读取 git 凭据的成型代码与 CI 内部信息）
_ci_*
# 临时排查脚本
_tmp_*
# 会话期根目录脚手架：两个并行会话的临时工具目录 / 台账 / 一次性 npm 试验（zznpmtest 含自己的
# node_modules，约 93MB）。与上面 _ci_*、_tmp_* 同理（M-03 曾把带 git 凭据读取的成型代码误入库）。
# 只锚定仓库根（`/` 前缀），避免误吞 src/tests/ 下的真测试文件。
/zztmpctl/
/zznpmtest/
/zz*.md
# 门禁自检（gateSelfTest）的仓库内夹具目录：正常路径由 finally 删除，但进程被 kill 时
# 来不及执行——曾残留一个含 320 行合成告警代码的副本。若被 `git add -A` 收进仓库，
# 它既污染 lint 门禁又污染基线，故在此兜底（锚定仓库根 + 只匹配该前缀）。
# 前缀必须与 gateSelfTest.test.js 里 fs.mkdtempSync 的模板逐字一致，改名时两处同步。
/.lint-ratchet-selftest-*/

# 内部留档目录（2026-09-28）：评估报告、审计台账、性能/复杂度基线数据。
# 本仓库是**公开仓库**（github.com/qmzzzzz/fsms），而该目录含带 `file:line` 坐标的
# 可利用漏洞细节（fail-open 路径、越权臂、审计链抹哈希手法等）⇒ 不进入版本库。
# 本地文件完整保留；代码注释里出现的 `deliverables/...` 路径指内部留档，克隆仓库中不存在
# （说明见 CONTRIBUTING.md §9）。历史版本仍在 git 历史中（最后一次入库提交 b50cb40），
# 取回方式见 deliverables/审计与迭代汇总-2026-09-28.md §6。
deliverables/

# jest 本地运行临时目录（haste map / 日志）
.jesttmp/
