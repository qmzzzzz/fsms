# ===== 密钥注入方式（P3-48）=====
# 下面的 JWT_SECRET / AES_SECRET_KEY 等可以直接写在本文件（适合本地开发），
# 也可以改为文件注入（生产/容器强烈推荐）：为任意密钥变量追加 _FILE 后缀，
# 值指向挂载的密钥文件路径，应用启动期会读文件并注入，例如
#   JWT_SECRET_FILE=/run/secrets/jwt_secret
# 支持文件注入的变量见 src/config/secrets.js 的 FILE_BACKED_SECRETS。
#
# 【L-01 单一事实来源】同一个密钥**只在一处定义**，不要既在本文件写明文、
# 又在 secrets/ 放一份取值不同的副本——那会造成「轮换只改一处、旧密钥仍可用」
# 的静默失效。两种合法用法（二选一，勿混用）：
#   a) 本地开发：直接在本文件写明文（当前方式）；
#   b) 生产/容器：只配 *_FILE 指向 secrets/，本文件不写同名变量。
# 若两者同时存在且取值不同，应用会在启动期输出告警并以文件为准
# （src/config/secrets.js:86-91）——告警出现即说明违反了本约定，请立即清理。
# 轮换后的验证步骤见 deployment/secret-rotation.md「收尾检查清单」。
#
# 为什么容器环境要用文件：环境变量会被 `docker inspect` 完整回显、
# 被 `docker compose config` 打进 CI 日志、被子进程无条件继承，
# 并可通过 /proc/<pid>/environ 读取——它不是机密载体。
# docker-compose.yml 已按此方式配置（secrets: 段）。
# 同时提供 NAME 与 NAME_FILE 且取值不同时，以文件为准并输出告警。

# 服务器配置
PORT=3000
# 开发默认；生产部署必须显式写 production/prod。
# 2026-10-24 审计：除 development/dev/local/test/ci 与 staging 外（含未识别值与空串），
# 一律按生产语义执行硬闸——拼错（prodution）不会让整套校验静默跳过。
# 额外保险：设 REQUIRE_PRODUCTION_CONFIG=true 时，若当前环境不会进入生产校验，
# 启动直接失败（docker-compose.yml 已注入 true，防"以为在做生产校验"）。
NODE_ENV=development
# REQUIRE_PRODUCTION_CONFIG=true
# 日志里的 service 字段（默认 fire-safety-api），多服务共用日志平台时用于区分来源
# SERVICE_NAME=fire-safety-api

# 业务时区（IANA 名称，默认 Asia/Shanghai）。
# 影响仪表盘「今日」边界与审计按天聚合——不设置时按默认东八区计算，
# 容器通常跑 UTC，跨时区部署**必须**显式声明，否则「今天」的归属会与预期不符。
# 非法值会在生产启动期被 config/validate.js 拒绝（P2-36），不再拖到首个请求才抛。
# TZ_BUSINESS=Asia/Shanghai

# MongoDB 配置
MONGODB_URI=mongodb://localhost:27017/fire_safety_db
# 认证缺口告警（H-1，2026-10-29 二轮渗透）：URI 未携带 user:pass 时，启动会打一条
# 「安全加固告警」——mongod 若未开 authorization，任何能到达 27017 的对端都可读写全库
# （克隆管理员、插后门账号、删封禁记录、伪造审计链）。TLS 只保护链路，不解决这一点。
# 本项**只告警不阻断启动**；受信内网确实运行免认证实例时，显式设为 true 关掉该告警，
# 并在部署文档记录拓扑依据。生产 compose 注入的 URI 自带凭据，无需设置。
# MONGODB_AUTH_EXEMPT=false
# 传输加密（P2-8）：生产环境指向非回环主机时，URI 必须追加 ?tls=true，
# 否则启动校验拒绝（凭据与数据不得明文过网）。同宿主受信容器网络确要豁免，
# 显式设置 MONGODB_TLS_EXEMPT=true 并在部署文档记录拓扑依据；默认不豁免。
# MONGODB_TLS_EXEMPT=false
# 连接池上限（默认 20）。原默认 10 在高并发下易排队等待连接；
# 按压测结果调整，过大会放大 Mongo 侧并发压力。
# MONGO_MAX_POOL_SIZE=20
# 连接池预热数（默认 2）：过低会让突发流量付出建连延迟。
# MONGO_MIN_POOL_SIZE=2
# 初始选主超时 ms（默认 5000）：过大会让「连不上」迟迟不报错。
# MONGO_SERVER_SELECTION_TIMEOUT_MS=5000
# socket 空闲超时 ms（默认 45000）：过小会在慢查询上误断。
# MONGO_SOCKET_TIMEOUT_MS=45000
# 心跳频率 ms（默认 10000）：过低增加无谓流量。
# MONGO_HEARTBEAT_MS=10000
# 池满时请求排队上限 ms（默认 10000）：不设则无限等待，表现为请求"卡住"而非快速失败。
# MONGO_WAIT_QUEUE_TIMEOUT_MS=10000

# 部署拓扑：本地/单容器保持 1；横向扩容必须显式声明实例数并同时配置 REDIS_URL
INSTANCE_COUNT=1
# 部署期声明的**真实副本数**（F-12，2026-10-17）。
# 与上面的 INSTANCE_COUNT 语义不同：INSTANCE_COUNT 是"多进程证据"（>1 才触发告警），
# 而本变量是"自证单副本"的唯一凭据——K8s Deployment 的 replicas 不会自动注入任何
# 环境变量，Pod 名也不带序号，进程无法自己知道有几个副本，只能由部署渲染阶段
# （helm/kustomize 模板替换或 initContainer 调 API）写入。
#   RUNTIME_INSTANCE_COUNT=1  ⇒ 已声明单副本，启动期不再提示"无法自证单副本"
#   RUNTIME_INSTANCE_COUNT>1  ⇒ 与 INSTANCE_COUNT 同等对待，启动期打 error + 失效清单
#   未设置/非法值             ⇒ 在 K8s 集群内时打 warn（列出可能降级的机制）
# 不要写死成 1 后长期不管：它必须随实际 replicas 变化，否则等于自欺。
# RUNTIME_INSTANCE_COUNT=1
# 多进程检测的其余输入（constants/runtime.js 的 detectMultiProcess）。
# 这些机制（审计哈希链、审计 WAL、限流计数、用户缓存）全依赖单进程假设，
# 检测到多进程时启动日志会列出确切失效清单——任何一项 > 1 都会触发告警。
# 编排器注入的副本数（K8s Deployment 用 REPLICAS，等效于 INSTANCE_COUNT）。
# REPLICAS=1
# Node cluster / gunicorn 风格的工作进程数（> 1 即视为多进程）。
# WEB_CONCURRENCY=1
# 同上，另一种命名习惯。
# CLUSTER_WORKERS=1
# PM2 cluster 模式自动注入（0..N-1）；非 0 即视为非首实例。
# NODE_APP_INSTANCE=0
#
# 破坏性运维脚本的库名白名单（scripts/destructiveGuard.js，M-08 / P1-20）。
# 注意：**不要写进 .env**——它是 per-command 的临时声明，随命令传入即可：
#   ALLOWED_SOURCE_DB=fire_safety_db node scripts/resign-audit-hmac.js --apply
# 未设置白名单时所有 --apply 类脚本一律拒绝执行（fail-closed），这是有意设计：
# 防止把「重写审计链 HMAC」「dropIndex」「吊销会话」误打到非预期库。
# 多个库用英文逗号分隔。
# REDIS_URL=redis://redis:6379
# 同上（P2-8）：非回环主机的 Redis 生产必须 rediss:；同宿主受信容器网络豁免时
# 显式设置 REDIS_TLS_EXEMPT=true。回环地址（127.0.0.1/localhost）无需任何旗标。
# REDIS_TLS_EXEMPT=false
# Redis 认证（2026-10-01 审计 finding，validate.js 生产闸）：会话缓存/限流计数/
# IP 黑名单广播全在 redis 上，无认证等于任何同网容器都能改写。口令生产经 compose
# secrets 挂载（REDIS_PASSWORD_FILE=/run/secrets/redis_password，见 generate-secrets.js），
# 不要写进本文件；REDIS_AUTH_EXEMPT=true 仅限受信内网的免认证部署（显式豁免，不许静默）。
# REDIS_PASSWORD=
# 列表链查询预算（2026-10-01 审计 finding，src/utils/queryBudget.js）：业务列表/统计查询
# 的 maxTimeMS 兜底（毫秒）。默认 10000；夹取 [500, 300000]，非法值回退默认。
# LIST_QUERY_MAX_TIME_MS=10000

# REDIS_AUTH_EXEMPT=false

# JWT 配置（生产环境必须修改为强随机密钥！）
# 生成方法: openssl rand -base64 48（或 node scripts/generate-secrets.js 一次生成全套）
# 下方 <CHANGE_ME> 是占位符：它会被 config/validate.js 判为弱密钥并**拒绝生产启动**。
# 这行在模板里保持原样是刻意的——照抄模板直接上生产必须起不来，而不是静默可用。
JWT_SECRET=<CHANGE_ME>
# 访问令牌有效期，默认 2h（与 config/index.js 的默认值一致）
JWT_EXPIRE=2h
# 生成方法: openssl rand -base64 48
JWT_REFRESH_SECRET=<CHANGE_ME>
JWT_REFRESH_EXPIRE=7d

# ===== JWT 多密钥轮换（P2-3，可选）=====
# 默认（不配置以下四项）保持单密钥语义：签发不写 kid，验签只用上面两把密钥。
# 需要"不踢下线地换钥"时：
#   1. 把新旧密钥一起放进 JSON 对象（kid → secret），当前签发钥由 CURRENT_KID 指定；
#   2. 让全体旧令牌自然过期（≥ JWT_REFRESH_EXPIRE）后再删旧钥。
# 轮换期无 kid 的历史令牌仍用上面的 JWT_SECRET / JWT_REFRESH_SECRET 验签：
#   · 停用前不要清空它们；
#   · 旧钥泄露时恰恰要**清空**（清空即拒绝全部无 kid 令牌，是唯一关得掉旧钥的开关），
#     配了 JWT_SECRETS / JWT_REFRESH_SECRETS 后这两项不再强制要求强度。
# 完整步骤见 deployment/secret-rotation.md。
# 启动校验（生产）：JSON 形状、每把钥强度、CURRENT_KID 必须存在、
# access 与 refresh 两侧不得出现同值密钥——任一不满足直接拒绝启动。
# JWT_SECRETS={"k2":"<新密钥>","k1":"<旧密钥>"}
# JWT_CURRENT_KID=k2
# JWT_REFRESH_SECRETS={"r2":"<新密钥>","r1":"<旧密钥>"}
# JWT_REFRESH_CURRENT_KID=r2

# 加密密钥（用于敏感数据加密，生产环境必须设置）
# 生成方法: openssl rand -hex 32
AES_SECRET_KEY=<CHANGE_ME>
# 生成方法: openssl rand -hex 16
# 注意：这里按 README 给的是 hex 16（32 字符，满足 32 字符下限）。
# 若改用 openssl rand -hex 32（64 字符）同样合法，强度更高。
HMAC_SECRET=<CHANGE_ME>

# ===== 登录口令传输加密（ECDH 私钥，口令密文轨用）=====
# 登录/注册/改密/关闭MFA 的口令以 ECDH+HKDF+AES-GCM 密文上行（字段名 encPassword 等），
# 明文口令字段为灰度兼容轨。私钥缺失时启动期自动生成临时密钥对（重启换钥，
# 前端自动重新获取公钥，不影响功能），生产环境建议文件注入持久密钥：
#   LOGIN_ECDH_PRIVATE_KEY_FILE=/run/secrets/login_ecdh_key
# 生成方法（P-256，支持 P-256/P-384）:
#   openssl genpkey -algorithm EC -pkeyopt ec_paramgen_curve:P-256 -out login_ecdh_private.pem
# 环境变量直填时 PEM 换行可写作字面量 \n
# LOGIN_ECDH_PRIVATE_KEY=<PEM 私钥>
# S-2 构建期钉扎：前端包可钉死服务端公钥指纹（防主动 MITM 替换公钥）。
# 取值 = 公钥 SPKI DER 的 SHA-256（64 位 hex），scripts/generate-secrets.js 会打印，
# 也可由私钥现算：node scripts/login-key-pin.js ./secrets/login_ecdh_private_key
# docker compose build 前 export，Dockerfile 同时写入运行期的
# LOGIN_PUBLIC_KEY_SHA256_PIN，启动时比对，不一致直接失败（轮换私钥后须重建前端）。
# VITE_LOGIN_PUBLIC_KEY_SHA256=<64 位 hex>
# 明文轨开关：前端全量切换到密文轨后设 true 拒绝明文口令
# ⚠️ 仅 HTTPS/localhost 部署可开——纯 HTTP 内网下浏览器无 WebCrypto，
#    前端只能走明文降级轨，开 strict 会把用户锁在门外
# 生产建议：经 HTTPS 访问的部署应设为 true（前端已全量支持密文轨，含降级
#    上报，无切换成本）。保持 false 时启动期会输出 loud warning，并计入安全
#    告警 login_encrypt_strict_disabled（medium）——不阻断启动：判据是声明式
#    的，致命闸会拦死纯 HTTP 内网这一合法部署形态（config/loginEncryptGuard.js）
# LOGIN_ENCRYPT_STRICT=false

# ===== 可观测性 =====
# Prometheus 指标端点（/metrics：QPS/延迟直方图/错误计数/安全告警计数）
# 设 false 关闭端点暴露（采集照常，仅为省一个内部端口面时使用）
# METRICS_ENABLED=true
# /metrics 应用层鉴权纵深（可选）：内网/回环来源始终放行（本机与容器网络
# 内 Prometheus 直连零配置兼容）；配置后额外允许携带正确 Bearer 令牌的
# 跨网段抓取，公网来源一律 401。生成方法: openssl rand -hex 32
# 未配置时退化为「仅内网放行」，绝不 fail-open 到公网可读
# METRICS_TOKEN=<CHANGE_ME>
# docker compose 部署经 secrets/metrics_token → METRICS_TOKEN_FILE 注入；生产校验要求
# ≥32 字符强随机值。配置后经反代访问 /metrics 必须携带该令牌（容器私网直抓仍放行）。
# 就绪探针 /readyz（含 Mongo ping）始终可用，无需配置

# 安全告警 webhook（钉钉/企业微信/Slack 等通用 JSON 入口）
# 触发事件：暴力破解（critical）、批量数据导出、权限滥用、黑名单 IP 命中（high）
# SECURITY_ALERT_WEBHOOK=https://hooks.example.com/xxx
# 最低投递级别（low/medium/high/critical，默认 high——低于该级的告警只记日志）
# SECURITY_ALERT_MIN_LEVEL=high
# 可选：webhook 主机白名单（逗号分隔；配置后仅放行名单内主机，
# 承接「域名单独无法校验内网指向」的残余 SSRF 面，生产建议必配）
# SECURITY_ALERT_WEBHOOK_ALLOWLIST=hooks.example.com
# HMAC-SHA256 签名密钥（经 X-Webhook-Signature 头下发，接收端验签防伪造）。
# 2026-10-24 审计：配置了 webhook 就**必须**配置本项（启动期致命），否则接收方
# 无法区分伪造/重放；webhook URL 也必须是 https（告警载荷与签名头不得明文外发）。
# 生产校验要求 ≥32 字符强随机值。
# 生成方法: openssl rand -hex 16
# SECURITY_ALERT_WEBHOOK_SECRET=<CHANGE_ME>

# ===== 部署（docker compose / scripts/deploy.js）=====
# 应用镜像引用，与 docker-compose.yml 的 image: ${APP_IMAGE:-...} 对应。
# 生产发布**必须**显式指定带版本 tag 的镜像（CI 推送到 GHCR，如
# ghcr.io/<owner>/<repo>:sha-abc1234）；留空时回落到本地开发默认值
# fire-safety-app:local，而 scripts/deploy.js 会**拒绝**用它发布——
# 那个 tag 指向本机某个未版本化的构建，无法回答「线上是哪个 commit」。
# APP_IMAGE=ghcr.io/owner/repo:sha-abc1234

# 告警接收端就绪度闸门（scripts/deploy.js 前置校验，2026-09-26 审计 Top-2）。
# docker-compose.yml 直接挂载仓库内 deployment/observability/alertmanager.yml，
# 而仓库版本是占位 URL ⇒ 照抄上线时 critical 告警全部发往 hooks.example.com：
# 告警静默丢失，Prometheus 页面却一切正常，没有人被叫醒。
# 故部署前置校验会以**生产口径**校验该文件：占位即拒绝发布（早于任何变更）。
# 若采用「独立挂载覆盖」注入（alertmanager.yml 文件头注释的第 2 种方式），
# 用下面这项指向真实配置的路径——指向的文件仍要过同一道判据，不是绕过。
# ALERTMANAGER_CONFIG_PATH=./secrets/alertmanager.prod.yml
# 显式豁免（仅限无告警的演练环境）。只认字面 true；开启等于书面承认
# 本次发布后告警不会触达任何人，校验结果会以警告形式打印在部署日志里。
# ALLOW_PLACEHOLDER_ALERT_WEBHOOK=false
# 合规检查侧的同源闸门（人工/上线前触发；CI 不设——仓库模板本身必须是占位）：
#   ALERT_WEBHOOK_CHECK=production node scripts/compliance-check.js

# CORS 配置（逗号分隔的允许来源）
# 未配置且非 development 时会回退到固定的本地开发白名单并告警
# （不会回显任意来源），生产环境务必配置具体域名列表
# 2026-10-24 审计：生产校验会逐项解析每个来源——必须是完整来源
# （scheme://host[:port]，不得带路径/查询/fragment/userinfo），且必须是 https://。
# credentials:true 下 http 来源可被网络攻击者注入；开发环境不受此闸约束。
CORS_ORIGIN=http://localhost:3001,https://yourdomain.com

# 审计与日志留存天数（合规区间 90..3650，默认 180）
# 单一声明见 src/constants/retention.js：审计库 TTL 与日志文件轮转共用此值。
# 超出区间会被钳制，且 scripts/compliance-check.js 会判为不通过
# （钳制意味着配置意图与实际留存不一致，必须显形而非静默修正）
# AUDIT_RETENTION_DAYS=180

# ===== 业务数据保留期（F-07，2026-10-17）=====
# 业务方口径：全部 180 天（等保 2.0 三级「审计/日志留存不少于六个月」同口径）。
# 声明在 src/constants/businessRetention.js（declaredDays=180），本组变量是**开关**：
# 不配置 ⇒ 不建 TTL、数据永久保留（合规检查会判不通过并写明"数据永久保留"）。
#
# 建索引前的四道闸（缺一即拒绝建，见 assertBusinessRetentionEnforceable）：
#   ① 业务口径已声明；② 变量已配置且可解析；③ 落在合规区间内（未被钳制）；
#   ④ 生效值不得大于声明天数。
#
# ⚠ TTL 删除不可逆且无任何提示。首次在生产启用前，先按 180 天口径评估存量数据
#   影响（scripts/compliance-check.js 会列出各集合当前生效值），并确认归档流程已就绪。
# 字段口径：报警按 occurredAt、巡检按 planStartTime（事件时间，非入库时间）。
# BUSINESS_RETENTION_DAYS_FIRE_ALARM=180
# BUSINESS_RETENTION_DAYS_INSPECTION=180
# BUSINESS_RETENTION_DAYS_FIRE_DEVICE=180
# User 不建 TTL（删账号会让审计链上的操作者变成悬空引用），其 180 天口径体现为
# 匿名化（services/userService.anonymizeById），由运维按同一周期执行。
# BUSINESS_RETENTION_DAYS_USER=180

# ===== 发布必填项：备份/恢复目标 RPO / RTO（F-08，2026-10-17）=====
# 声明值（业务方拍板，写在 src/constants/backupObjectives.js 的 declaredHours）：
#   RPO = 24h、RTO = 4h。本组变量是**部署侧的生效开关**，与声明分开：
#   改口径走代码评审，改部署只动这里，可分别回退。
#
# ⚠ 这两项是 scripts/deployPolicy.js 的**发布硬门禁**：值缺失、超出允许区间
#   或被静默钳制都会拒绝发布（首次部署最常见的中止原因就是它们被注释掉）。
#   下方给出的是声明口径；业务方另定口径时先改 src/constants/backupObjectives.js，
#   再同步这里——只改部署侧会被合规检查判为「配置宽于对外声明」。
#
# ⚠ 这两个数字的依据，别在测评材料里写成「等保规定」：
#   - RPO 24h 由**备份频率技术下限**决定（每日 02:00 全量 + 发布前一次），
#     等保三级只要求"有本地备份与恢复""有异地数据备份"，未规定小时数；
#   - RTO 4h 是**业务决策值**（半天内恢复），可执行形态是演练实测耗时 ≤ 4h。
#
# 判据（两条方向相反，都要过）：
#   - 配得比 24h 更严（如 12h）⇒ 巡检 error：备份频率兑现不了这个承诺；
#   - 配得比声明更宽（如 48h）⇒ 巡检与合规检查 error：承诺了却没做到；
#   - 发布路径（scripts/deployPolicy.js）要求**显式给值**，不给即拒绝发布；
#     启动路径不判，避免已在运行的服务重启失败。
BACKUP_RPO_HOURS=24
BACKUP_RTO_HOURS=4

# ===== 备份加密与异地副本（P1-①）=====
# scripts/backup-mongo.sh 默认 gpg 非对称加密。gpg 模式下 BACKUP_GPG_RECIPIENT
# **必填**：收件人公钥须已导入备份宿主机，私钥不得放在备份宿主机上
# （初始化步骤见 deployment/backup-encryption.md）。未配置时脚本在 mongodump
# **之前**硬失败，不会先导出明文再失败；cron 与 scripts/deploy.js 都读本变量。
# 仅当备份介质已按同等强度保护时，才允许改用
# BACKUP_ENCRYPTION=plaintext-acknowledged（取值本身即书面确认，脚本仍打 error 日志）。
# BACKUP_ENCRYPTION=gpg
# BACKUP_GPG_RECIPIENT=ops@example.net
# 异地副本命令（可选；配置后执行失败会令整次备份失败，不会静默吞掉）
# BACKUP_OFFSITE_CMD=rclone copy ./backups remote:fsms-backups

# ===== 审计缓冲与落库（内存缓冲 → 定时/WAL 兜底落库）=====
# 缓冲硬上限（条）。达到上限且无法回收时会整体丢弃并告警——过大等于把更多
# 已确认响应给客户端的审计记录押在内存里，过小则频繁触发落库。
# AUDIT_BUFFER_HARD_LIMIT=10000
# WAL 文件路径。默认按库名派生（logs/audit-buffer.<库名>.wal）；
# 多实例共用同一日志目录时**必须**各自指定，否则互相覆盖。
# AUDIT_WAL_PATH=logs/audit-buffer.fire_safety_db.wal
# WAL 单文件字节上限（默认 52428800 = 50MB）
# AUDIT_WAL_MAX_BYTES=52428800
# 每写 N 条检查一次 WAL 体积（默认 32）。调小更及时、调大更省 stat 开销
# AUDIT_WAL_STAT_INTERVAL=32
# 异常检测扫描间隔（毫秒，默认 300000 = 5 分钟）。区间 30000 ~ 86400000（24h）：
# 低于下限被抬到 30s；高于上限被压到 24h——Node 对超过 2^31-1ms 的 setInterval 会**静默**
# 改成 1ms（只打一条 TimeoutOverflowWarning），那会让"配置 34 天"变成每毫秒一轮全量聚合，
# 而合规面板照报配置值。抬升/压到边界都会 logger.warn 留痕，面板读数恒等于定时器真实时长。
# 每轮的检测窗口跟着这个间隔走（= 间隔 + 2×30s 重叠），不是固定 5 分钟：
# 把间隔调大只为降负载时，窗口同步变大，时间轴不会被跳过一大片
# AUDIT_MONITOR_INTERVAL_MS=300000
# 审计链周期核验间隔（毫秒，默认 600000 = 10 分钟）。区间 60000 ~ 86400000（24h）：
# 与上一项同一个缺口类（低于下限抬到 1 分钟：低于它会与异常检测抢库；高于上限压到 24h）。
# 单轮核验的服务端预算取 max(60s, 生效间隔)，故上限同时约束了一轮的 maxTimeMS。
# AUDIT_CHAIN_MONITOR_INTERVAL_MS=600000
# 审计链写入锁的超时（毫秒，默认 15000）。持锁者崩溃后其他写入者等待此时长
# 即放弃并告警，避免审计写入被单个僵死进程无限阻塞
# AUDIT_CHAIN_LOCK_TIMEOUT_MS=15000

# ===== 取证捕获（P2，2026-10-31）：只对 forensicTrigger 标记的 IP 采集全量请求/响应 =====
# 总开关。默认开启；设为 false 时整条链路直接跳过（不采样、不落库、不留痕）。
# 单个请求是否被采集由 services/forensicTrigger 的标记决定，本变量只是"能力闸"。
# FORENSIC_CAPTURE_ENABLED=true
# 取证 WAL 路径。默认按库名派生（logs/forensic-capture.<库名>.wal）；
# 多实例共用日志目录时**必须**各自指定，否则互相覆盖。
# FORENSIC_WAL_PATH=logs/forensic-capture.fire_safety_db.wal
# 取证 WAL 单文件字节上限（默认 52428800 = 50MB）。超限时丢最旧一半并归档到 .discarded
# （取证是尽力而为的证据，容量语义与审计 WAL 相反：宁可留最近一段，也不无限增长）。
# FORENSIC_WAL_CAP_BYTES=52428800
# 每写 N 条检查一次 WAL 体积（默认 32）
# FORENSIC_WAL_STAT_INTERVAL=32
# 请求头/请求体/响应头/响应体的采集上限（字节）。超限一律截断并留可见标记，
# 同时记录全文的 sha256 与原始字节数——"被截断"必须看得出来，不能静默丢内容。
# FORENSIC_REQ_HEADER_CAP=8192
# FORENSIC_REQ_BODY_CAP=16384
# FORENSIC_RES_HEADER_CAP=4096
# FORENSIC_RES_BODY_CAP=65536
# 容量闸（任务书 §1.3）：单 IP 每分钟条数/字节数上限，超出后按 1/N 采样（默认 N=10）；
# 全局每日字节预算用尽即停捕。采样、丢弃、截断都有计数与限频告警，不会静默。
# FORENSIC_PER_IP_PER_MIN=300
# FORENSIC_PER_IP_BYTES_PER_MIN=5242880
# FORENSIC_GLOBAL_DAILY_BYTES=2147483648
# FORENSIC_SAMPLE_EVERY_N=10
# 取证记录保留期（天）。区间 [30,3650]，声明值 30（用户 2026-10-31 书面确认）；未配置则不建 TTL。
# 下限独立于审计链（审计留存仍 90 天）。配得比声明的 30 天更长会被拒绝建索引。
# BUSINESS_RETENTION_DAYS_FORENSIC_CAPTURE=30

# ===== 蜜罐诱饵账户（撞库陷阱）：把幽灵账号/哨兵名升级为可登录的诱饵账户 =====
# 总开关。未置真值（默认）⇒ 不物化任何账户、不放行任何标志位账户（库里有标志位账户也不放行）。
# 开启后会在 users 集合里创建一批**零角色**诱饵账户（因此它们**是**真实存在的行），
# 但被排除在所有用户枚举面（列表/计数/统计/成员清单/对账）之外。
# HONEYPOT_ENABLED=false
# 诱饵名单（逗号分隔，整份覆盖默认名单、不做并集）。条目 trim + 小写、重复项去重、
# 空条目逐条记 errors；全部无效则回退默认名单并告警——不静默把诱饵关掉。
# 默认名单 = sysadmin + 10 个默认哨兵名 + admin；**超管名（默认 admin）自动剔除**：
# 生效名单恒不含当前 SUPER_ADMIN_USERNAME（改名后 admin 才会成为诱饵）。
# 名单里若有名字已被真实账户占用 ⇒ 该名拒绝接管并 fail-loud 报错（绝不把真人账户打标成蜜罐）。
# HONEYPOT_USERNAMES=sysadmin,administrator,root,user,test,guest,system,oracle,postgres,backup,demo
# 哨兵（幽灵账号）名单：这些名字在库里**不存在**，任何口令都进不去，被尝试即告警
# （canary_username_attempt）。默认 10 个与诱饵默认名单同源；被蜜罐接管的名字上，
# 哨兵信号退役（换成交互式诱饵会话），接管关系逐条登记（见 ADR-013 P1d）。
# CANARY_USERNAMES=administrator,root,user,test,guest,system,oracle,postgres,backup,demo
# 蜜罐事件链巡检间隔（毫秒，默认 300000 = 5 分钟，取值区间 60000–86400000：低于下限抬到 60s、
# 高于上限压到 24h——Node 对超过 2^31-1ms 的 setInterval 会静默改成 1ms，等于每毫秒扫一遍审计表）。
# 每轮把「同一来源 IP 在一个业务日内」跨过 ≥2 个蜜罐阶段的链升级成一条 honeypot_chain_escalated 告警；
# 同一 IP 每业务日只升级一次（凭据是审计行本身，跨重启/跨实例一致）；单轮最多升级 50 条，
# 当日已升级的来源不占名额，其余候选顺延到下一轮（计数见 compliance.honeypotChainHealth）。
# HONEYPOT_CHAIN_INTERVAL_MS=300000

# ===== 缓存 =====
# 统计缓存 TTL（秒，默认 300）。统计为派生数据且写路径已主动失效，
# 延长可提高命中率、降低聚合查询压力
# STATS_CACHE_TTL=300
# 统计缓存最大条目数（默认 500），超出后按最旧条目淘汰
# STATS_CACHE_MAX_SIZE=500
# 过期条目清理间隔（毫秒，默认 120000）
# STATS_CACHE_CLEANUP_INTERVAL=120000
# 无 Redis 时的进程内缓存条数上限（默认 20000，下限 1000）
# SHARED_CACHE_MEM_MAX=20000
# /readyz 的 Mongo ping 结果缓存时长（毫秒，默认 1000；0=关闭缓存）。
# 探针被 LB 高频调用，缓存把 Mongo 压力压成常数
# READYZ_CACHE_MS=1000

# ===== 安全告警 =====
# 告警频控表条目上限（默认 10000），超出且过期项不足以回收时整体清空
# ALERT_RATE_LIMIT_MAX=10000
# webhook 并发投递上限（默认 5）
# SECURITY_ALERT_MAX_CONCURRENT=5

# ===== 日志转发（SIEM）=====
# 配置 LOG_SHIPPING_URL 后启用 HTTP 批量转发；不配置则仅落本地文件
# LOG_SHIPPING_URL=https://siem.example.com/ingest
# F-09（2026-10-17）：未配置时合规检查第 7 项不再写"关闭状态、不计缺陷"，而是判 notReady——
# 生产部署门禁（COMPLIANCE_STRICT=1）会因此阻断。确实没有 SIEM 的部署（单机/离线）
# 用下面这条显式豁免：豁免后仍保留 notReady 留痕，只是不再阻断发布。
# ALLOW_UNCONFIGURED_LOG_SHIPPING=true
# 目标门禁（P2-9）：内网/回环/链路本地目标（含云元数据端点 169.254.169.254）
# 默认拒绝，启动转发前即报错。确属内网 SIEM 时把主机名/IP/网段（逗号分隔）
# 加入下方白名单显式放行；条目与 IP 名单同一把尺（支持 CIDR）。
# LOG_SHIPPING_ALLOW_PRIVATE_HOSTS=siem.corp,10.0.0.0/8
# LOG_SHIPPING_TOKEN=<CHANGE_ME>
# 2026-10-24 审计：LOG_SHIPPING_URL 必须是 https://（日志内容不得明文出站）。
# 明文 http 端点须显式设置 LOG_SHIPPING_ALLOW_INSECURE=true；但**带令牌的明文
# 组合永远拒绝**（Bearer 令牌不得明文过网，启动期致命）。生产校验要求令牌 ≥32 字符。
# LOG_SHIPPING_ALLOW_INSECURE=false
# 满额条数（默认 100）/ 定时毫秒（默认 5000）/ 单次请求超时（默认 5000）
# LOG_SHIPPING_BATCH=100
# LOG_SHIPPING_INTERVAL_MS=5000
# LOG_SHIPPING_TIMEOUT_MS=5000

# ===== 一次性迁移开关 =====
# 允许解密无认证的 AES-CBC 遗留密文（默认关闭）。仅用于存量数据迁移，
# 开启即重新暴露填充预言机攻击面，迁移完成后**必须**移除。
# 生产环境开启会在启动期输出告警（config/validate.js 的 collectProductionWarnings）
# ALLOW_LEGACY_CBC_DECRYPT=true


# 公开注册开关（false=关闭，仅管理员可创建用户）
# ⚠️ 生产环境建议设为 false，防止未授权用户自行注册
ALLOW_PUBLIC_REGISTRATION=false

# 登录图形验证码开关（false=关闭，默认关闭）
# 运行时可由管理员在"用户管理"页动态切换；此值仅在数据库配置读取失败时作回退
LOGIN_CAPTCHA_ENABLED=false

# 注册接口人机校验（默认开启：REGISTER_CAPTCHA_ENABLED !== 'false' 即为开）
# REGISTER_CAPTCHA_ENABLED=true
# 注册 IP 限流：默认 10 次 / 5 分钟 / IP
# REGISTER_IP_WINDOW_MS=300000
# REGISTER_IP_MAX_REQUESTS=10

# 安全配置
RATE_LIMIT_WINDOW_MS=900000
# 登录防护阈值（挑战 / 锁定 / 判据窗口）：默认 3 次要求人机校验、
# 窗口 15 分钟、10 次失败锁定、锁定 10 分钟，与代码默认值一致。
# LOGIN_CHALLENGE_AFTER=3          连续失败多少次后要求人机校验（1..50）
# LOGIN_CHALLENGE_WINDOW_MS=900000 挑战判据的统计窗口（60s..24h）
# LOGIN_CHALLENGE_STICKY_MS=21600000 挑战粘滞窗（60s..7d，默认 6h）：闸门拦下的尝试在此窗口内
#                                   持续要求人机验证，成功登录即清零——防"3 次猜测+等窗口"的持续枚举
# LOGIN_LOCK_AFTER=10              失败多少次把账户临时锁定（1..100）
# LOGIN_LOCK_MS=600000             锁定时长（60s..24h）
RATE_LIMIT_MAX_REQUESTS=300
BCRYPT_ROUNDS=12
# ===== 多进程（可选，默认单进程）=====
# 单机多核且已外置 Redis 时启用：CLUSTER_WORKERS=N（N>1）后用 `npm run start:cluster`
# （即 node src/cluster.js）代替 `npm start`。worker 数上限 16。
# 未配置 REDIS_URL 时不要开启：审计哈希链/限流计数/缓存失效依赖单进程假设，
# 多进程且无分布式锁时 /readyz 会主动不就绪（防审计链分叉，属预期行为）。
# 容器化部署优先加副本数而不是本开关。
# CLUSTER_WORKERS=2
# cluster 优雅关停兜底宽限（primary 等 worker 的最长时间，默认 10s）
# CLUSTER_SHUTDOWN_GRACE_MS=10000
# bcrypt 计算卸载到 worker 线程（默认开；=0 关闭回退进程内，=1 测试环境也强制开启）。
# 纯 JS 的 bcryptjs 在主线程上跑 cost-12 约数百毫秒/次，登录高峰会拖慢全部接口；
# 卸载后主线程只做消息往返，多 worker 并行等效于按核数扩展登录吞吐。
# BCRYPT_WORKER_THREADS=1
# worker 线程数（默认 min(CPU 核数, 4)，上限 16）
# BCRYPT_WORKERS=2
# bcrypt 轮数（10..14，默认 12）。生产校验会拒绝区间外的值：
# 过小（<10）不足以抵抗离线爆破，过大（如 20）会让每次哈希耗时数十秒，
# 属 DoS 自伤——实测 10→149ms、12→516ms、14→1902ms、16→7235ms（本机）。
# 仅影响新哈希，存量哈希仍可校验，可在用户下次改密时自然升级。

# Cookie Secure 属性：生产环境强制开启；非生产可显式开启以本地验证
# COOKIE_SECURE=true

# 日志配置
LOG_LEVEL=info
# 运行日志的 PII 掩码与凭据脱敏（O-1，默认开启）。
# 开启时：email/手机号/身份证做局部掩码，password/token/secret/cookie 类字段整体替换为
# [REDACTED]；审计库（AuditLog）不受影响——取证记录按原样保留，访问受权限与二次验证约束。
# 仅在排查需要核对原文时临时设为 false：关闭动作本身会以 warn/error 落一条日志。
# LOG_PII_MASK=true
# 日志目录：缺省为仓库 logs/。容器化部署把日志写到挂载卷时显式指定；
# 绝对路径与相对进程工作目录的路径都接受（内部按 path.resolve 归一）。
# LOG_DIR=/var/log/fire-safety

# 报表导出并发闸（P-2）：导出会为每个请求在内存里建整份 workbook，
# 并发数直接决定内存峰值。超出上限的请求进有界队列等待，超时才回 429 + Retry-After。
# 取值一律钳制：max ∈ [1,8]、queue ∈ [0,64]、timeout ∈ [1000,300000]，
# 越界或非数字会退回默认值并在启动日志里 warn 一次（导出闸的配置错误不该让服务起不来）。
# EXPORT_MAX_CONCURRENCY=2
# EXPORT_MAX_QUEUE=8
# EXPORT_QUEUE_TIMEOUT_MS=30000

# Sentry 错误监控（可选，生产环境建议配置）
# 获取地址: https://sentry.io
# SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0

# API 文档（Swagger UI）
# 生产环境默认关闭，设为 true 才暴露 /api-docs
# ENABLE_API_DOCS=false
# 开启后可设置 Basic Auth 保护（建议生产环境必设）
# DOCS_USERNAME=admin
# DOCS_PASSWORD=change-me

# IP 限流配置
# RATE_LIMIT_IP_WINDOW_MS=3600000
# RATE_LIMIT_IP_MAX_REQUESTS=1000

# ===== CC 防护升级（限流触发 → 自动封禁阶梯 1h→4h→24h→7d）=====
# 计数按**信号类别**分桶，各类别阀值相差 10 倍——因为各限流器的"合法拒绝率"
# 相差两个数量级，把它们加进同一个桶等于宣称"30 次验证码拒绝"与"30 次任意请求
# 拒绝"是同一种证据。判据是"一次拒绝能证明多少恶意"，详见
# src/services/rateLimitEscalation.js 文件头。
#
#   ANON_ABUSE  端点滥用（未认证）—— captcha / login-ip / register
#               一次拒绝已证明该 IP 在单端点上打了远超人类速率的请求。**封 IP**
#   VOLUME      体量超限（未认证）—— general / ip
#               单 IP 总请求数被超过，合法 NAT 共享出口能到这个量级。**封 IP**
#   AUTH        已认证操作越限 —— strict / user-ip
#               越界的是**账号**不是 IP：一个管理员批量开户（建号+改密+派角色）
#               就能打满 strict，而该封账号不该封共享出口。**只告警不封 IP**，
#               处置走账号侧（userLimiter 配额 / 账户锁定 / MFA 失败锁定）
#
# 混检不提前：10 次 captcha + 90 次 general 不会让 ANON_ABUSE 到点，各按各的量纲判。
#
# 阀值（单位：窗口内的**拒绝**次数；令牌桶按 CC_ESCALATION_WINDOW_MS 匀速回填，
# 故"持续速率恰好等于阀值"不触发升级）
# CC_ESCALATION_THRESHOLD_ANON=10
# CC_ESCALATION_THRESHOLD_VOLUME=100
# CC_ESCALATION_THRESHOLD_AUTH=30
# CC_ESCALATION_WINDOW_MS=300000
#
# 计数表容量：键是攻击者可控的来源 IP。超限时按**压力升序**淘汰（最接近升级的
# 留得住），刻意不整体清空——那会给"轮换 N 个 IP"一条一键重置所有计数的旁路。
# CC_ESCALATION_MAX_TRACKED=10000
# CC_ESCALATION_EVICT_RATIO=10
#
# 计数在进程内（刻意不引 Redis 新依赖面）：多实例下实际封禁阀值 =
# 配置阀值 × 实例数，方向是"少封不误封"；429 拦截本身仍由各限流器自己的
# 共享存储跨实例保证，不受此影响。

# ===== 口令复用历史 =====
# 改密时拒绝复用最近 N 条**已退役**口令（NIST SP 800-63B 不强制要求，
# 但复用是真实攻击路径：口令泄露后施压改回原口令、或跨系统轮换同一弱口令）。
# 摘要为 HMAC-SHA256（pepper = HMAC_SECRET）。轮换 HMAC_SECRET 后既有摘要失效、
# 历史归零，轮换窗口内这条防线短暂变弱——没有明文就无法重算，属已知取舍。
# 取值夹到 [1,24]：上限是为了防止误配后单文档膨胀（每条 64 字符 hex）。
# PASSWORD_HISTORY_DEPTH=5

# ===== TLS 终结（生产必选其一；2026-09-11 起校验放宽为二选一）=====
# 生产校验要求 TLS 必须在某一层终结，以下二者满足其一即可，皆无则启动失败：
#   a) 进程自启 HTTPS：ENABLE_HTTPS=true 并自备证书（下方 TLS_CERT_PATH/TLS_KEY_PATH）；
#   b) 前置反代终结（推荐，README/docker-compose 的目标形态）：保持 ENABLE_HTTPS 关闭，
#      并显式设置 TLS_TERMINATED_UPSTREAM=true。
#
# 2026-10-24 审计修正：原判据拿 TRUST_PROXY_HOPS + ALLOWED_HOSTS 的**存在性**推断
# 「反代终结了 TLS」。这两项本来就必须配置（限流与 Host 白名单各要一个），于是判据
# 恒真——一台上线时忘了配 nginx TLS 的部署同样能过。现在改为**专用声明**：
# 部署方必须明确说"TLS 在上一层终结"，而不是被别处的必填项顺带满足。
# docker-compose.yml 已为容器形态默认注入 TLS_TERMINATED_UPSTREAM=true。
# 本地/内网自测 TLS 时，先用 scripts/generate-dev-cert.sh 生成自签名证书到 ./certs
# ENABLE_HTTPS=true
# TLS_CERT_PATH=./certs/server.crt
# TLS_KEY_PATH=./certs/server.key
# 前置反代终结 TLS 的显式声明（compose 形态默认 true；裸跑进程须自行声明）
# TLS_TERMINATED_UPSTREAM=true

# 反向代理层数（生产在代理后必须设置，用于正确获取客户端真实 IP，避免限流/IP 黑名单误判）
# TRUST_PROXY_HOPS=1

# 可信代理网段（F-01，2026-10-16 审计 P1）：逗号分隔的 CIDR 列表，声明「谁有权替客户端
# 写 X-Forwarded-For」。未配置时判据退回「socket 对端属私网/回环即可信」——而私网是
# **位置**不是**代理身份**：同一容器网络内任意服务直连应用端口并自带该头，与真实反代
# 在应用视角完全同形，可据此影响 IP 白名单/黑名单、IP/用户/账号三层限流配额、
# 自动封禁的打击对象与审计记录里的来源地址。
# 生产部署在反向代理之后**应当配置**（配了就以名单为准，私网不再是理由）：
# 2026-10-24 审计：docker-compose.yml 已把该项改为 `${TRUSTED_PROXY_CIDRS:?}`
# 强制显式——不配则 `docker compose up` 直接失败，不再静默退回兼容档。
# TRUSTED_PROXY_CIDRS=10.0.0.0/8
# 多段用逗号分隔，IPv4 与 IPv6 可混排：
# TRUSTED_PROXY_CIDRS=10.0.0.0/8,172.16.5.0/24,fd00::/8
# 只有一台代理时可以直接写裸地址（按单主机处理：IPv4 /32、IPv6 /128）：
# TRUSTED_PROXY_CIDRS=172.28.0.5
# 空项、解析不出的文本、全域网段（0.0.0.0/0、::/0）一律启动致命失败——
# 全域网段等于宣布「整个互联网都是我的可信代理」，比完全不配更糟。

# PROXY protocol 连接层还原（ADR-021，2026-11-04）：L4 负载均衡（云 NLB、HAProxy、F5）
# **直连后端 3000 端口**时，LB 在转发首字节前先发一行 v1 文本头或一段 v2 二进制头声明
# 真实客户端四元组；on 时后端在 HTTP/TLS 解析前消费它并重写 socket 对端地址，
# req.ip / 限流 / 封禁 / 审计自动取到真实客户端。取值只有 off / on（默认 off）——
# off 时不创建前置服务器，监听路径与未引入本功能前逐字节一致；容器网 Prometheus
# 直抓 /metrics 与 docker healthcheck 不发 PROXY 头，透传语义保证它们不受影响。
# on 的两个硬条件：① TRUSTED_PROXY_CIDRS 必须已配置（名单是「谁有权发头」的唯一凭据，
# 生产启动闸强制两者同时配置，缺失即拒绝启动）；② 名单必须覆盖 LB 的实际源网段，
# 名单外对端发 PROXY 头会被断开并计入 proxy_protocol_header_rejected 安全告警。
# 若 LB 经宿主 nginx 转发（常规拓扑），保持默认 off——由 nginx 的
# listen proxy_protocol + real_ip_header proxy_protocol 消费（见
# deployment/nginx.conf.example 变体拓扑段），应用侧判据完全不变。
# 刻意不支持：PROXY_PROTOCOL=on 与 ENABLE_HTTPS=true 同时启用（启动即拒）——
# Node 的 TLSSocket 在句柄层读连接，看不到已被消费的 PROXY 头字节，TLS 握手会
# 永久悬挂（ADR-021 决定 ⑥）。需要 PROXY 头的部署一律让 LB 终结 TLS。
# PROXY_PROTOCOL=off

# Host 头白名单（G6）：逗号分隔，含端口时需分别列出。
# 留空则 protocolCompliance 跳过 Host 校验，此时必须由前置反代固定 Host；
# 服务直接暴露的部署强烈建议配置，防止 Host 头注入（如密码重置链接投毒）。
# 生产环境未配置时启动会致命失败（M3）：它同时是「声明由前置反代终结 TLS」的必要条件之一。
# ALLOWED_HOSTS=api.yourdomain.com,api.yourdomain.com:443

# CSP 违规上报开关（G9）：开启后 CSP 头附加 report-uri，
# 浏览器将违规详情 POST 到 /csp-report（无需认证，仅限流+体积上限）。
# CSP_REPORT_ENABLED=true

# Trusted Types 强制模式（A7，2026-10-16）。
# 默认关闭：`require-trusted-types-for 'script'` 只下在
# Content-Security-Policy-Report-Only 里（观察，不拦截）。
# 置 true 后该指令移入主 CSP（强制拦截），report-only 那条退化为 no-op——
# 同一条策略只下发一处，不会两个头各发一遍。
# 判据是**字面量 'true'**（`src/middleware/security/securityHeaders.js` 的 `=== 'true'`），
# 其他取值（含 '1'/'yes'）一律按关闭处理。
# ⚠️ 开启前先确认前端已无未迁移的 innerHTML / document.write 类赋值：
# 强制态下这类写入会被浏览器直接拒绝执行（页面功能性报错，不是"多一条告警"）。
# TRUSTED_TYPES_ENFORCE=false

# 安全联络邮箱（G10）：用于 /.well-known/security.txt 的 Contact 字段
# SECURITY_CONTACT_EMAIL=security@yourdomain.com
# security.txt 的 Canonical 字段（RFC 9116 可选）。取值优先级：
#   本变量 → ALLOWED_HOSTS 首项 → 整行缺省。
# 三者都不含请求内容：**永不反射 Host 头**，因为该端点公开且响应可被共享缓存。
# 留空即可——不输出这一行比输出一个错的地址诚实。
# SECURITY_TXT_CANONICAL=https://api.yourdomain.com/.well-known/security.txt
# security.txt 的 Policy 字段（RFC 9116 可选）：指向对外可达的安全响应政策页
# （漏洞报告流程、披露时限、安全承诺等）。未配置则整行缺省——不输出比输出
# 一个 404 的链接诚实。值中的换行会被截断（换行即新字段，防环境变量注入伪字段）。
# SECURITY_POLICY_URL=https://yourdomain.com/security-policy

# 唯一超级管理员账户名：系统只允许一位超管，归属由启动期对账固定，
# 任何 HTTP 接口都不能变更（剥离会造成不可恢复的自锁死）。
# 留空默认为 admin；改动此项后重启会把超管角色迁移到新账户并剥离旧账户。
# SUPER_ADMIN_USERNAME=admin

# 初始超级管理员的邮箱与初始口令（仅**首次**初始化时用于建号）。
# ADMIN_INITIAL_PASSWORD 留空则生成随机口令，写入项目根目录的
# `.admin-initial-password`（0600，并在支持的平台收紧 ACL、回读复核）——
# **不会**打印到启动日志；文件写入失败时也不会把口令写进日志，此时只能停止服务、
# 显式设置本变量后重启（见 src/services/initData/adminAccount.js）。
# 邮箱冲突时会自动降级为唯一后备邮箱（同一目录下的 adminAccount.js）。
# 生产语义下显式值必须通过 validatePasswordStrength（≥12 位，含大小写/数字/
# 特殊字符，且不在常见泄露口令表），否则启动失败；未设置时生成的口令同样满足该策略。
# 口令走 bcrypt 落库，此处为明文注入，建议配合 *_FILE 或 secrets 挂载使用。
# ADMIN_INITIAL_EMAIL=admin@example.com
# ADMIN_INITIAL_PASSWORD=<CHANGE_ME>

# ===== 前端静态托管（L-1）=====
# 'auto'=仅 NODE_ENV=production 且产物存在时由后端托管（默认）；
# 'true'/'false' 强制开/关（改用 Nginx 托管时置 false，纯 API 节点同理）。
# SERVE_FRONTEND=auto
# 自定义产物目录；留空时用默认 web-admin/dist
# FRONTEND_DIST=

# API 文档端点限流：默认 30 次 / 15 分钟 / IP（文档页首屏约 5 个请求）。
# 该限流同时覆盖 /api-docs 与 /api-docs.json，是 Basic Auth 爆破的主要拦截面。
# DOCS_RATE_LIMIT_MAX=30
# 文档限流窗口 ms（默认 900000 = 15 分钟）。
# DOCS_RATE_LIMIT_WINDOW_MS=900000

# ===== 应用内一键升级（蓝绿升级，2026-10-30）=====
# 应用只把「签名的升级请求」写进队列目录，不执行 docker/nginx；执行侧是宿主机上的
# scripts/hotUpgradeAgent.js（systemd timer，见 deployment/systemd/）。
# 未启用时概览端点仍可读，但按钮显示为不可用，POST 返回 UPGRADE_DISABLED。
# UPGRADE_ENABLED=false
# 宿主侧队列目录（compose 把它 bind mount 到容器内 /var/lib/fsms/upgrade）。
# 宿主代理的 UPGRADE_QUEUE_DIR 必须指向同一个路径。
# UPGRADE_QUEUE_HOST_DIR=/var/lib/fsms/upgrade
# 应用容器内看到的队列目录。compose 已固定为 /var/lib/fsms/upgrade（= bind mount 目标），
# 不经 compose 直跑进程时才需要显式设置——它必须与宿主代理看到的是同一份目录。
# UPGRADE_QUEUE_DIR=/var/lib/fsms/upgrade
# 镜像仓库白名单（逗号分隔前缀）。空白名单 = 全拒（fail-closed），不是全放。
# 例：ghcr.io/qmzzzzz/
# HOT_UPGRADE_REGISTRY_ALLOWLIST=
# 代理心跳过期判定（秒）。代理每 10s 续写一次，默认 120s 容忍。
# UPGRADE_AGENT_STALE_SECONDS=120
# 请求在队列里停留超过该秒数后代理拒绝执行（默认 1800 = 30 分钟）。
# UPGRADE_REQUEST_TTL_SECONDS=1800
# 概览页返回的历史任务条数（1..50，默认 10）。
# UPGRADE_HISTORY_LIMIT=10
# 宿主代理侧的 nginx 主配置路径（含 upstream fsms_app），仅代理读取：
# HOT_UPGRADE_NGINX_CONF=/etc/nginx/nginx.conf
# 宿主代理的 HMAC 密钥必须与应用一致（应用容器内是 /run/secrets/hmac_secret）：
# HMAC_SECRET_FILE=/etc/fsms/secrets/hmac_secret
